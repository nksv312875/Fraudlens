# FraudLens AI - Environment Configuration

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Model Artifacts
MODEL_STORE_DIR=model_store
CHAMPION_MODEL_FILE=fraudlens_predictor.joblib

# Database
SQLITE_DB_PATH=data/fraudlens.db

# Operational Review Thresholds (Validation Fitted)
TAU_LOW=0.20
TAU_HIGH=0.80

# Demo Mode Flags
SYNTHETIC_BENCHMARK_MODE=True
ENABLE_LIVE_STREAM_SIMULATOR=True
