as fitted with feature names\r\n  warnings.warn(\r\nC:\\Users\\S Nandhakumar\\AppData\\Local\\Programs\\Python\\Python312\\Lib\\site-packages\\sklearn\\utils\\validation.py:2830: UserWarning: X does not have valid feature names, but StandardScaler was fitted with feature names\r\n  warnings.warn(\r\nC:\\Users\\S Nandhakumar\\AppData\\Local\\Programs\\Python\\Python312\\Lib\\site-packages\\sklearn\\utils\\validation.py:2830: UserWarning: X does not have valid feature names, but StandardScaler was fitted with feature names\r\n  warnings.warn(\r\nC:\\Users\\S Nandhakumar\\AppData\\Local\\Programs\\Python\\Python312\\Lib\\site-packages\\sklearn\\utils\\validation.py:2830: UserWarning: X does not have valid feature names, but StandardScaler was fitted with feature names\r\n  warnings.warn(\r\n[1/4] Connecting to SQLite database...\r\n[2/4] Loading trained predictor and dataset...\r\n[3/4] Scoring 2474 transactions through ML pipeline...\r\n      Persisted 2474 scored transactions to SQLite.\r\n[4/4] Seeding initial investigator review audit trail...\r\nDatabase seeding completed successfully.\r\n"}
