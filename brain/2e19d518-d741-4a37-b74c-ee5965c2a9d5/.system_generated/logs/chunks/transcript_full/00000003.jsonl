{"step_index":303,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-29T13:36:41Z","input_tokens":2832,"cache_read_tokens":129921,"output_tokens":2214,"thinking":"Testing the core API and model pipeline is essential, a quick verification with a test client seems appropriate, but a more comprehensive pytest suite should be written. Considering the prompt's testing requirements, constructing a pytest suite in a dedicated file seems like the best approach to cover all aspects mentioned.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"\"\"\"\nFraudLens AI - Automated Test Suite\nCovers:\n- Zero-leakage Feature Engineering\n- Model Prediction & Calibrated Uncertainty\n- Three-Outcome Triage Logic\n- Reproducible Demo Cases (Case A, Case B, Case C)\n- NetworkX Graph & Syndicate Clustering\n- SQLite Feedback Persistence & Overrides\n- Counterfactual Simulator\n- Core FastAPI Endpoints\n\"\"\"\n\nimport pytest\nimport numpy as np\nfrom fastapi.testclient import TestClient\nfrom app.main import app\nfrom app.ml.features import FeatureExtractor\nfrom app.ml.predictor import FraudLensPredictor\nfrom app.graph.engine import FraudGraphEngine\nfrom app.db.repository import DatabaseManager, FeedbackRepository, TransactionRepository\n\nclient = TestClient(app)\n\ndef test_api_health():\n    response = client.get(\"/api/health\")\n    assert response.status_code == 200\n    data = response.json()\n    assert data[\"status\"] == \"healthy\"\n    assert \"model_version\" in data\n    assert data[\"synthetic_demo_badge\"] is True\n\ndef test_api_overview_metrics():\n    response = client.get(\"/api/overview\")\n    assert response.status_code == 200\n    data = response.json()\n    assert \"summary\" in data\n    assert data[\"summary\"][\"total_analyzed\"] >= 2000\n    assert \"risk_distribution\" in data\n    assert len(data[\"risk_distribution\"]) == 3\n    assert \"evaluation_metrics\" in data\n    assert \"champion_model\" in data[\"evaluation_metrics\"]\n\ndef test_api_queue_sorting_and_filtering():\n    # Filter HIGH RISK only\n    response = client.get(\"/api/queue?triage_category=HIGH%20RISK&limit=10\")\n    assert response.status_code == 200\n    data = response.json()\n    for item in data[\"items\"]:\n        assert item[\"triage_category\"] == \"HIGH RISK\"\n\n    # Sort by amount descending\n    response_amt = client.get(\"/api/queue?sort_by=amount&ascending=false&limit=5\")\n    assert response_amt.status_code == 200\n    items = response_amt.json()[\"items\"]\n    amounts = [i[\"amount\"] for i in items]\n    assert amounts == sorted(amounts, reverse=True)\n\ndef test_demo_case_a_legitimate_unusual():\n    response = client.get(\"/api/transactions/TXN-DEMO-A101\")\n    assert response.status_code == 200\n    data = response.json()\n    txn = data[\"transaction\"]\n    assert txn[\"transaction_id\"] == \"TXN-DEMO-A101\"\n    assert txn[\"amount\"] == 950.00\n    # Legitimate transaction on trusted device should NOT be HIGH RISK\n    assert txn[\"triage_category\"] in [\"LOWER RISK\", \"UNCERTAIN\"]\n    assert \"case_summary\" in data\n    assert len(data[\"case_summary\"][\"observed_evidence\"]) > 0\n\ndef test_demo_case_b_account_takeover():\n    response = client.get(\"/api/transactions/TXN-DEMO-B202\")\n    assert response.status_code == 200\n    data = response.json()\n    txn = data[\"transaction\"]\n    assert txn[\"transaction_id\"] == \"TXN-DEMO-B202\"\n    # Multiple signals: new device, foreign IP, 4 failed attempts -> HIGH RISK\n    assert txn[\"triage_category\"] == \"HIGH RISK\"\n    assert txn[\"risk_score\"] >= 80.0\n    reason_codes = [c[\"code\"] for c in txn[\"feature_contributions\"]]\n    assert \"FAILED_AUTH_BURST\" in reason_codes\n    assert \"FOREIGN_ORIGIN\" in reason_codes\n\ndef test_demo_case_c_graph_syndicate():\n    response = client.get(\"/api/graph/ego/TXN-DEMO-C301\")\n    assert response.status_code == 200\n    data = response.json()\n    assert data[\"has_syndicate_overlap\"] is True\n    assert \"DEV-RING-777\" in data[\"shared_devices\"] or len(data[\"shared_devices\"]) > 0\n\ndef test_counterfactual_simulator():\n    # Take high-risk case B and modify failed attempts to 0 and reduce amount\n    cf_payload = {\n        \"transaction_id\": \"TXN-DEMO-B202\",\n        \"modified_amount\": 120.00,\n        \"modified_failed_attempts\": 0,\n        \"modified_country\": \"US\"\n    }\n    response = client.post(\"/api/replay/counterfactual\", json=cf_payload)\n    assert response.status_code == 200\n    res = response.json()\n    assert res[\"transaction_id\"] == \"TXN-DEMO-B202\"\n    assert res[\"modified_risk_score\"] < res[\"original_risk_score\"]\n    assert res[\"risk_score_delta\"] < 0\n    assert \"Caution: Modifying an individual feature\" in res[\"interpretability_warning\"]\n\ndef test_feedback_submission_and_override():\n    feedback_payload = {\n        \"transaction_id\": \"TXN-DEMO-A101\",\n        \"decision\": \"legitimate\",\n        \"reviewer_name\": \"Test Investigator QA\",\n        \"notes\": \"Verified by automated unit test.\"\n    }\n    response = client.post(\"/api/feedback\", json=feedback_payload)\n    assert response.status_code == 200\n    res = response.json()\n    assert res[\"status\"] == \"success\"\n    assert res[\"recorded_feedback\"][\"decision\"] == \"legitimate\"\n\ndef test_queue_simulation_capacity():\n    sim_payload = {\"daily_review_capacity\": 30}\n    response = client.post(\"/api/queue/simulation\", json=sim_payload)\n    assert response.status_code == 200\n    res = response.json()\n    assert res[\"daily_capacity\"] == 30\n    assert res[\"cases_reviewed\"] == 30\n    assert \"capacity_precision\" in res\n\ndef test_behavioral_change_analysis():\n    response = client.get(\"/api/replay/behavioral-change/TXN-DEMO-A101\")\n    assert response.status_code == 200\n    data = response.json()\n    assert \"behavioral_changes\" in data\n    assert len(data[\"behavioral_changes\"]) > 0\n    # Must use neutral phrasing\n    for change in data[\"behavioral_changes\"]:\n        assert \"neutral_assessment\" in change\n\ndef test_csv_upload_validation_error():\n    # Upload malformed CSV missing required 'amount' column\n    malformed_csv = \"transaction_id,account_id\\nTXN-ERR-1,ACC-1\\n\"\n    response = client.post(\n        \"/api/upload-csv\",\n        files={\"file\": (\"test.csv\", malformed_csv, \"text/csv\")}\n    )\n    assert response.status_code == 422\n    assert \"missing mandatory columns\" in response.json()[\"detail\"]\n","Overwrite":true,"Path":"C:\\Users\\S Nandhakumar\\.gemini\\antigravity\\scratch\\fraudlens-ai\\backend\\tests\\test_api_and_ml.py"}}]}
