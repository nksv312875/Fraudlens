{"step_index":394,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-29T13:44:07Z","input_tokens":2713,"cache_read_tokens":183416,"output_tokens":1327,"tool_calls":[{"name":"write_file","args":{"Content":"export interface FeatureContribution {\n  code: string;\n  impact: 'LOW' | 'MEDIUM' | 'HIGH' | 'CRITICAL';\n  description: string;\n  value: string;\n}\n\nexport interface Transaction {\n  transaction_id: string;\n  timestamp: string;\n  account_id: string;\n  amount: number;\n  currency: string;\n  merchant_id?: string;\n  merchant_category: string;\n  device_id: string;\n  ip_address: string;\n  location_country: string;\n  account_age_days: number;\n  failed_attempts_last_24h: number;\n  is_fraud_label?: number;\n  risk_score: number;\n  calibrated_prob: number;\n  triage_category: 'HIGH RISK' | 'UNCERTAIN' | 'LOWER RISK';\n  uncertainty_indicator: number;\n  review_priority: number;\n  model_version: string;\n  investigation_status?: string;\n  assigned_investigator?: string;\n  feature_contributions?: FeatureContribution[];\n  raw_features?: Record<string, any>;\n  simulation_badge?: string;\n}\n\nexport interface CaseSummary {\n  observed_evidence: string[];\n  main_score_contributors: string[];\n  related_records: string;\n  missing_information: string;\n  uncertainty_analysis: string;\n  recommended_verification_steps: string[];\n}\n\nexport interface OverviewStatistics {\n  summary: {\n    total_analyzed: number;\n    high_risk_cases: number;\n    uncertain_cases: number;\n    lower_risk_cases: number;\n    confirmed_fraud_feedback: number;\n    investigator_overrides: number;\n  };\n  evaluation_metrics: {\n    held_out_test_records: number;\n    held_out_test_fraud_cases: number;\n    champion_model: {\n      algorithm: string;\n      precision: number;\n      recall: number;\n      f1_score: number;\n      roc_auc: number;\n      pr_auc: number;\n      confusion_matrix: {\n        true_negative: number;\n        false_positive: number;\n        false_negative: number;\n        true_positive: number;\n      };\n      precision_at_capacity_top20: number;\n    };\n    baseline_model: {\n      algorithm: string;\n      precision: number;\n      recall: number;\n      f1_score: number;\n      roc_auc: number;\n    };\n  };\n  risk_distribution: Array<{\n    category: string;\n    count: number;\n    percentage: number;\n    color: string;\n  }>;\n  top_evidence_reasons: Array<{\n    code: string;\n    count: number;\n    description: string;\n  }>;\n  model_metadata: {\n    version: string;\n    trained_date: string;\n    train_samples: number;\n    feature_columns: string[];\n  };\n  thresholds: {\n    tau_low: number;\n    tau_high: number;\n  };\n}\n\nexport interface CounterfactualResponse {\n  transaction_id: string;\n  model_version: string;\n  original_risk_score: number;\n  modified_risk_score: number;\n  risk_score_delta: number;\n  original_category: string;\n  modified_category: string;\n  changed_inputs: Record<string, { original: any; modified: any }>;\n  interpretability_warning: string;\n}\n\nexport interface ReplayTimelineEvent {\n  transaction_id: string;\n  timestamp: string;\n  amount: number;\n  merchant_category: string;\n  device_id: string;\n  risk_score: number;\n  triage_category: string;\n  leakage_classification: string;\n  is_target: boolean;\n}\n\nexport interface BehavioralChangeItem {\n  signal: string;\n  observation: string;\n  neutral_assessment: string;\n}\n\nexport interface GraphNode {\n  id: string;\n  node_type: 'transaction' | 'account' | 'device' | 'ip' | 'merchant';\n  label: string;\n  amount?: number;\n  is_fraud?: number;\n  account_count?: number;\n}\n\nexport interface GraphEdge {\n  source: string;\n  target: string;\n  relation: string;\n  evidence: string;\n}\n\nexport interface EgoGraphData {\n  root_transaction: string;\n  nodes: GraphNode[];\n  edges: GraphEdge[];\n  cluster_node_count: number;\n  shared_devices: string[];\n  shared_ips: string[];\n  has_syndicate_overlap: boolean;\n}\n\nexport interface SyndicateCluster {\n  entity_type: string;\n  entity_id: string;\n  shared_account_count: number;\n  accounts: string[];\n  associated_transactions: string[];\n  risk_level: string;\n  narrative: string;\n}\n\nexport interface FeedbackRecord {\n  id: number;\n  transaction_id: string;\n  decision: string;\n  reviewer_name: string;\n  notes: string;\n  model_version: string;\n  original_model_score: number;\n  original_category: string;\n  is_override: number;\n  created_at: string;\n}\n","Overwrite":true,"Path":"C:\\Users\\S Nandhakumar\\.gemini\\antigravity\\scratch\\fraudlens-ai\\frontend\\src\\types\\index.ts"}}]}
