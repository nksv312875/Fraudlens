{"step_index":414,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-29T13:48:41Z","input_tokens":3422,"cache_read_tokens":217973,"output_tokens":2490,"thinking":"Building the Feedback History component focuses on capturing and displaying investigator decisions within a table. This will involve recording reviewer decisions, associated timestamps, notes, and the model version used. Crucially, the system must clearly highlight overrides where reviewer judgments diverge from model predictions, ensuring a controlled workflow distinguishes initial assessments from confirmed findings.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import React, { useState, useEffect } from 'react';\nimport {\n  CheckSquare,\n  AlertTriangle,\n  RotateCcw,\n  UserCheck,\n  ShieldAlert,\n  HelpCircle,\n  ShieldCheck,\n  Search,\n  ExternalLink\n} from 'lucide-react';\nimport { FeedbackRecord } from '../types';\nimport { api } from '../services/api';\n\ninterface FeedbackHistoryProps {\n  onSelectTransaction: (id: string) => void;\n}\n\nexport const FeedbackHistory: React.FC<FeedbackHistoryProps> = ({\n  onSelectTransaction,\n}) => {\n  const [records, setRecords] = useState<FeedbackRecord[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [search, setSearch] = useState('');\n\n  const loadFeedback = async () => {\n    setLoading(true);\n    try {\n      const res = await api.getFeedbackHistory(100);\n      setRecords(res.feedback_records);\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    loadFeedback();\n  }, []);\n\n  const filtered = records.filter(\n    (r) =>\n      r.transaction_id.toLowerCase().includes(search.toLowerCase()) ||\n      r.reviewer_name.toLowerCase().includes(search.toLowerCase()) ||\n      r.decision.toLowerCase().includes(search.toLowerCase())\n  );\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Top Banner */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-slate-700/60\">\n        <div>\n          <h1 className=\"text-xl font-bold tracking-tight text-slate-100 flex items-center gap-2\">\n            <CheckSquare className=\"w-5 h-5 text-teal-400\" />\n            Investigator Feedback & Audit History\n          </h1>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Immutable SQLite audit records of analyst resolutions, human-in-the-loop overrides, and model versioning logs.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={loadFeedback}\n            className=\"px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 text-xs flex items-center gap-1.5 transition\"\n          >\n            <RotateCcw className=\"w-3.5 h-3.5\" />\n            <span>Refresh Audit Log</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Governance & Retraining Policy Banner */}\n      <div className=\"p-4 bg-slate-850 border border-slate-700/80 rounded-xl flex items-start gap-3 text-xs\">\n        <AlertTriangle className=\"w-4 h-4 text-amber-400 shrink-0 mt-0.5\" />\n        <div className=\"space-y-1\">\n          <p className=\"font-semibold text-slate-200\">\n            Controlled Governance Notice: Zero Silent Retraining\n          </p>\n          <p className=\"text-slate-400 text-[11px] leading-relaxed\">\n            FraudLens AI does not silently retrain models on individual analyst clicks. Decisions are staged in the SQLite audit repository for batch data validation, drift analysis, challenger-champion benchmarking, and institutional compliance sign-off prior to model artifact promotion.\n          </p>\n        </div>\n      </div>\n\n      {/* Search Bar */}\n      <div className=\"flex items-center justify-between gap-3 bg-slate-850 p-3 rounded-xl border border-slate-700/80\">\n        <div className=\"relative w-full sm:w-80\">\n          <Search className=\"w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search by Transaction ID or Reviewer...\"\n            value={search}\n            onChange={(e) => setSearch(e.target.value)}\n            className=\"w-full bg-slate-900 border border-slate-800 rounded-lg pl-9 pr-3 py-1.5 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-500/60\"\n          />\n        </div>\n        <span className=\"text-xs font-mono text-slate-400\">\n          {filtered.length} Recorded Decisions\n        </span>\n      </div>\n\n      {/* Table */}\n      <div className=\"bg-slate-850 border border-slate-700/80 rounded-xl overflow-hidden shadow-sm\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left border-collapse text-xs\">\n            <thead>\n              <tr className=\"bg-slate-900/90 text-slate-400 font-mono text-[11px] border-b border-slate-700\">\n                <th className=\"py-3 px-4\">TRANSACTION ID</th>\n                <th className=\"py-3 px-4\">AUDIT DECISION</th>\n                <th className=\"py-3 px-4\">INVESTIGATOR</th>\n                <th className=\"py-3 px-4 text-center\">OVERRIDE?</th>\n                <th className=\"py-3 px-4\">ORIGINAL MODEL SCORE</th>\n                <th className=\"py-3 px-4\">MODEL VERSION</th>\n                <th className=\"py-3 px-4\">TIMESTAMP</th>\n                <th className=\"py-3 px-4\">NOTES</th>\n                <th className=\"py-3 px-4 text-right\">ACTION</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800 text-slate-200\">\n              {loading ? (\n                <tr>\n                  <td colSpan={9} className=\"py-12 text-center text-slate-400 font-mono\">\n                    Querying SQLite audit trail...\n                  </td>\n                </tr>\n              ) : filtered.length === 0 ? (\n                <tr>\n                  <td colSpan={9} className=\"py-12 text-center text-slate-400\">\n                    No feedback records found. Submit decisions in Transaction Detail.\n                  </td>\n                </tr>\n              ) : (\n                filtered.map((r) => (\n                  <tr key={r.id} className=\"hover:bg-slate-800/80 transition\">\n                    <td className=\"py-3 px-4 font-mono font-medium text-cyan-300\">\n                      {r.transaction_id}\n                    </td>\n                    <td className=\"py-3 px-4\">\n                      <span\n                        className={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full font-mono text-[10px] font-bold border capitalize ${\n                          r.decision === 'confirmed_fraud'\n                            ? 'bg-rose-950/80 text-rose-300 border-rose-800'\n                            : r.decision === 'legitimate'\n                            ? 'bg-teal-950/80 text-teal-300 border-teal-800'\n                            : 'bg-amber-950/80 text-amber-300 border-amber-800'\n                        }`}\n                      >\n                        {r.decision.replace('_', ' ')}\n                      </span>\n                    </td>\n                    <td className=\"py-3 px-4 font-medium text-slate-300\">\n                      {r.reviewer_name}\n                    </td>\n                    <td className=\"py-3 px-4 text-center\">\n                      {r.is_override === 1 ? (\n                        <span className=\"px-2 py-0.5 rounded bg-rose-950 text-rose-400 border border-rose-800 font-mono text-[10px] font-bold\">\n                          OVERRIDE\n                        </span>\n                      ) : (\n                        <span className=\"text-slate-500 font-mono text-[10px]\">Agreed</span>\n                      )}\n                    </td>\n                    <td className=\"py-3 px-4 font-mono text-slate-300\">\n                      {r.original_model_score?.toFixed(1) || 'N/A'} ({r.original_category || 'N/A'})\n                    </td>\n                    <td className=\"py-3 px-4 font-mono text-slate-400 text-[11px]\">\n                      {r.model_version}\n                    </td>\n                    <td className=\"py-3 px-4 font-mono text-slate-400 text-[11px]\">\n                      {new Date(r.created_at).toLocaleString()}\n                    </td>\n                    <td className=\"py-3 px-4 text-slate-300 max-w-xs truncate text-[11px]\" title={r.notes}>\n                      {r.notes || '—'}\n                    </td>\n                    <td className=\"py-3 px-4 text-right\">\n                      <button\n                        onClick={() => onSelectTransaction(r.transaction_id)}\n                        className=\"px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs inline-flex items-center gap-1 transition\"\n                      >\n                        <span>View</span>\n                        <ExternalLink className=\"w-3 h-3 text-cyan-400\" />\n                      </button>\n                    </td>\n                  </tr>\n                ))\n              )}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n};\n","Overwrite":true,"Path":"C:\\Users\\S Nandhakumar\\.gemini\\antigravity\\scratch\\fraudlens-ai\\frontend\\src\\components\\FeedbackHistory.tsx"}}]}
{"step_index":415,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-29T13:49:00Z","content":"Created At: 2026-10-29T19:19:00+05:30\nCompleted At: 2026-10-29T19:19:01+05:30\nCreated file."}
{"step_index":416,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-29T13:49:01Z","input_tokens":2553,"cache_read_tokens":221408,"output_tokens":2969,"tool_calls":[{"name":"write_file","args":{"Content":"import React, { useState } from 'react';\nimport {\n  UploadCloud,\n  FileText,\n  CheckCircle,\n  AlertCircle,\n  Download,\n  Check,\n  RefreshCw\n} from 'lucide-react';\nimport { api } from '../services/api';\n\ninterface CsvUploadProps {\n  onBatchScored: () => void;\n}\n\nexport const CsvUpload: React.FC<CsvUploadProps> = ({ onBatchScored }) => {\n  const [file, setFile] = useState<File | null>(null);\n  const [uploading, setUploading] = useState(false);\n  const [result, setResult] = useState<any>(null);\n  const [errorMsg, setErrorMsg] = useState<string>('');\n\n  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    if (e.target.files && e.target.files[0]) {\n      setFile(e.target.files[0]);\n      setErrorMsg('');\n      setResult(null);\n    }\n  };\n\n  const handleUpload = async () => {\n    if (!file) return;\n    setUploading(true);\n    setErrorMsg('');\n    try {\n      const res = await api.uploadCsv(file);\n      setResult(res);\n      onBatchScored();\n    } catch (err: any) {\n      setErrorMsg(err.message || 'CSV validation failed.');\n    } finally {\n      setUploading(false);\n    }\n  };\n\n  const downloadSampleTemplate = () => {\n    const csvContent =\n      \"transaction_id,account_id,amount,currency,merchant_category,device_id,ip_address,location_country,failed_attempts_last_24h\\n\" +\n      \"TXN-SAMPLE-01,ACC-2099,145.50,USD,grocery,DEV-9011,198.51.100.12,US,0\\n\" +\n      \"TXN-SAMPLE-02,ACC-2100,2850.00,USD,electronics,DEV-ANOM-77,203.0.113.88,NG,3\\n\" +\n      \"TXN-SAMPLE-03,ACC-2101,89.00,USD,fast_food,DEV-9012,198.51.100.14,US,0\\n\";\n\n    const blob = new Blob([csvContent], { type: 'text/csv' });\n    const url = window.URL.createObjectURL(blob);\n    const a = document.createElement('a');\n    a.href = url;\n    a.download = \"fraudlens_template.csv\";\n    a.click();\n    window.URL.revokeObjectURL(url);\n  };\n\n  const downloadPredictions = () => {\n    if (!result || !result.preview_records) return;\n    const blob = new Blob([JSON.stringify(result.preview_records, null, 2)], {\n      type: 'application/json',\n    });\n    const url = window.URL.createObjectURL(blob);\n    const a = document.createElement('a');\n    a.href = url;\n    a.download = \"fraudlens_batch_predictions.json\";\n    a.click();\n    window.URL.revokeObjectURL(url);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Top Banner */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-slate-700/60\">\n        <div>\n          <h1 className=\"text-xl font-bold tracking-tight text-slate-100 flex items-center gap-2\">\n            <UploadCloud className=\"w-5 h-5 text-cyan-400\" />\n            Batch Transaction Dataset CSV Ingestion\n          </h1>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Production schema validation, deduplication, missing value imputation, and pipeline batch scoring.\n          </p>\n        </div>\n\n        <button\n          onClick={downloadSampleTemplate}\n          className=\"px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 text-xs flex items-center gap-1.5 transition\"\n        >\n          <Download className=\"w-3.5 h-3.5 text-cyan-400\" />\n          <span>Download Sample CSV Template</span>\n        </button>\n      </div>\n\n      {/* Upload Zone */}\n      <div className=\"bg-slate-850 border-2 border-dashed border-slate-700 hover:border-cyan-500/60 rounded-xl p-8 text-center transition\">\n        <UploadCloud className=\"w-12 h-12 text-slate-400 mx-auto mb-3\" />\n        <h3 className=\"text-sm font-bold text-slate-200 mb-1\">\n          Select or Drop Transaction CSV File\n        </h3>\n        <p className=\"text-xs text-slate-400 max-w-md mx-auto mb-4\">\n          Mandatory fields: <span className=\"font-mono text-cyan-300\">transaction_id, account_id, amount</span>.\n          Optional: <span className=\"font-mono text-slate-300\">merchant_category, device_id, ip_address, location_country</span>.\n        </p>\n\n        <input\n          type=\"file\"\n          accept=\".csv\"\n          onChange={handleFileChange}\n          id=\"csv-file-input\"\n          className=\"hidden\"\n        />\n\n        <div className=\"flex items-center justify-center gap-3\">\n          <label\n            htmlFor=\"csv-file-input\"\n            className=\"px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-600 text-slate-200 text-xs font-semibold cursor-pointer transition\"\n          >\n            {file ? file.name : 'Browse Local Files'}\n          </label>\n\n          {file && (\n            <button\n              onClick={handleUpload}\n              disabled={uploading}\n              className=\"px-5 py-2 rounded-lg bg-cyan-600 hover:bg-cyan-500 font-semibold text-white text-xs flex items-center gap-2 transition active:scale-95\"\n            >\n              {uploading ? (\n                <>\n                  <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n                  Validating & Scoring Batch...\n                </>\n              ) : (\n                'Run Batch Inference'\n              )}\n            </button>\n          )}\n        </div>\n      </div>\n\n      {/* Validation Error Banner */}\n      {errorMsg && (\n        <div className=\"p-4 rounded-xl bg-rose-950/70 border border-rose-800 text-rose-300 text-xs flex items-start gap-3\">\n          <AlertCircle className=\"w-5 h-5 text-rose-400 shrink-0 mt-0.5\" />\n          <div className=\"space-y-1\">\n            <span className=\"font-bold block\">Validation Check Failed</span>\n            <p className=\"text-[11px] leading-relaxed\">{errorMsg}</p>\n          </div>\n        </div>\n      )}\n\n      {/* Success & Batch Preview */}\n      {result && (\n        <div className=\"bg-slate-850 border border-slate-700/80 rounded-xl p-5 space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-2 text-teal-400 text-sm font-bold\">\n              <CheckCircle className=\"w-4 h-4\" />\n              Batch Scored Successfully\n            </div>\n            <button\n              onClick={downloadPredictions}\n              className=\"px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-mono flex items-center gap-1.5\"\n            >\n              <Download className=\"w-3.5 h-3.5 text-teal-400\" />\n              <span>Export Predictions JSON</span>\n            </button>\n          </div>\n\n          <div className=\"grid grid-cols-3 gap-3 text-center text-xs\">\n            <div className=\"p-3 bg-slate-900 rounded-lg border border-slate-800\">\n              <span className=\"text-[10px] text-slate-400 block font-mono\">TOTAL ROWS</span>\n              <span className=\"font-mono font-bold text-slate-100 text-lg\">\n                {result.total_rows_received}\n              </span>\n            </div>\n            <div className=\"p-3 bg-slate-900 rounded-lg border border-slate-800\">\n              <span className=\"text-[10px] text-slate-400 block font-mono\">DUPLICATES REMOVED</span>\n              <span className=\"font-mono font-bold text-amber-400 text-lg\">\n                {result.duplicates_removed}\n              </span>\n            </div>\n            <div className=\"p-3 bg-slate-900 rounded-lg border border-slate-800\">\n              <span className=\"text-[10px] text-slate-400 block font-mono\">PERSISTED TO DB</span>\n              <span className=\"font-mono font-bold text-teal-400 text-lg\">\n                {result.successfully_scored}\n              </span>\n            </div>\n          </div>\n\n          <div className=\"space-y-2\">\n            <span className=\"text-xs font-bold text-slate-300 font-mono block\">\n              Preview Scored Records (First 5):\n            </span>\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full text-left border-collapse text-xs\">\n                <thead>\n                  <tr className=\"bg-slate-900 text-slate-400 font-mono text-[10px]\">\n                    <th className=\"p-2\">TXN ID</th>\n                    <th className=\"p-2\">ACCOUNT</th>\n                    <th className=\"p-2 text-right\">AMOUNT</th>\n                    <th className=\"p-2 text-center\">TRIAGE</th>\n                    <th className=\"p-2 text-center\">RISK SCORE</th>\n                    <th className=\"p-2 text-center\">UNCERTAINTY</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-slate-800 font-mono\">\n                  {result.preview_records.map((r: any) => (\n                    <tr key={r.transaction_id}>\n                      <td className=\"p-2 text-cyan-300\">{r.transaction_id}</td>\n                      <td className=\"p-2 text-slate-300\">{r.account_id}</td>\n                      <td className=\"p-2 text-right font-bold text-slate-100\">${r.amount.toFixed(2)}</td>\n                      <td className=\"p-2 text-center\">\n                        <span className=\"px-1.5 py-0.5 rounded text-[10px] bg-slate-800 text-slate-200\">\n                          {r.triage_category}\n                        </span>\n                      </td>\n                      <td className=\"p-2 text-center text-teal-400 font-bold\">{r.risk_score.toFixed(1)}</td>\n                      <td className=\"p-2 text-center text-slate-400\">{r.uncertainty_indicator.toFixed(2)}</td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n","Overwrite":true,"Path":"C:\\Users\\S Nandhakumar\\.gemini\\antigravity\\scratch\\fraudlens-ai\\frontend\\src\\components\\CsvUpload.tsx"}}]}
