{"step_index":408,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-29T13:47:02Z","input_tokens":5130,"cache_read_tokens":202561,"output_tokens":6362,"thinking":"The core feature requires an interactive transaction replay environment. Considering building a timeline view to display related events chronologically. This timeline will visualize transaction details, including timestamps and amounts, for investigative analysis.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import React, { useState, useEffect } from 'react';\nimport {\n  History,\n  Sliders,\n  TrendingUp,\n  AlertCircle,\n  HelpCircle,\n  ShieldCheck,\n  ShieldAlert,\n  Clock,\n  ArrowRight,\n  Sparkles,\n  Info,\n  RotateCcw,\n  CheckCircle2\n} from 'lucide-react';\nimport {\n  Transaction,\n  ReplayTimelineEvent,\n  BehavioralChangeItem,\n  CounterfactualResponse\n} from '../types';\nimport { api } from '../services/api';\n\ninterface ReplayLabProps {\n  transactionId: string;\n  onSelectTransaction: (id: string) => void;\n}\n\nexport const ReplayLab: React.FC<ReplayLabProps> = ({\n  transactionId,\n  onSelectTransaction,\n}) => {\n  const [activeSubTab, setActiveSubTab] = useState<'timeline' | 'behavior' | 'counterfactual' | 'summary'>('timeline');\n  const [loading, setLoading] = useState(true);\n\n  // Data states\n  const [timelineEvents, setTimelineEvents] = useState<ReplayTimelineEvent[]>([]);\n  const [behavioralChanges, setBehavioralChanges] = useState<BehavioralChangeItem[]>([]);\n  const [histAvg, setHistAvg] = useState<number>(0);\n  const [currAmount, setCurrAmount] = useState<number>(0);\n\n  // Counterfactual Interactive States\n  const [cfAmount, setCfAmount] = useState<number>(0);\n  const [cfFailedAttempts, setCfFailedAttempts] = useState<number>(0);\n  const [cfCategory, setCfCategory] = useState<string>('grocery');\n  const [cfResult, setCfResult] = useState<CounterfactualResponse | null>(null);\n  const [cfLoading, setCfLoading] = useState(false);\n\n  const loadReplayData = async () => {\n    setLoading(true);\n    try {\n      const [tlRes, bcRes, txnRes] = await Promise.all([\n        api.getReplayTimeline(transactionId),\n        api.getBehavioralChange(transactionId),\n        api.getTransactionDetail(transactionId)\n      ]);\n\n      setTimelineEvents(tlRes.events);\n      setBehavioralChanges(bcRes.behavioral_changes);\n      setHistAvg(bcRes.historical_average_amount);\n      setCurrAmount(bcRes.current_amount);\n\n      // Initialize counterfactual inputs with current transaction values\n      const currentTxn = txnRes.transaction;\n      setCfAmount(currentTxn.amount);\n      setCfFailedAttempts(currentTxn.failed_attempts_last_24h);\n      setCfCategory(currentTxn.merchant_category);\n\n      // Run initial counterfactual\n      const cfInit = await api.simulateCounterfactual({\n        transaction_id: transactionId,\n        modified_amount: currentTxn.amount,\n        modified_failed_attempts: currentTxn.failed_attempts_last_24h,\n        modified_merchant_category: currentTxn.merchant_category,\n      });\n      setCfResult(cfInit);\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    if (transactionId) {\n      loadReplayData();\n    }\n  }, [transactionId]);\n\n  const handleRunCounterfactual = async () => {\n    setCfLoading(true);\n    try {\n      const res = await api.simulateCounterfactual({\n        transaction_id: transactionId,\n        modified_amount: cfAmount,\n        modified_failed_attempts: cfFailedAttempts,\n        modified_merchant_category: cfCategory,\n      });\n      setCfResult(res);\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setCfLoading(false);\n    }\n  };\n\n  if (loading) {\n    return (\n      <div className=\"flex items-center justify-center h-96 font-mono text-cyan-400 text-sm\">\n        <div className=\"w-5 h-5 border-2 border-cyan-400 border-t-transparent rounded-full animate-spin mr-3\" />\n        Initializing FraudLens Replay Lab environment...\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Banner */}\n      <div className=\"bg-gradient-to-r from-navy-800 via-slate-850 to-navy-850 border border-cyan-500/30 rounded-xl p-5 shadow-lg\">\n        <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"p-1 rounded bg-cyan-950 border border-cyan-800 text-cyan-400 font-mono text-[10px] font-bold\">\n                CORE INNOVATION\n              </span>\n              <h1 className=\"text-xl font-bold tracking-tight text-slate-100 flex items-center gap-2\">\n                FraudLens Replay Lab\n              </h1>\n            </div>\n            <p className=\"text-xs text-slate-400 mt-1\">\n              Active Target: <span className=\"font-mono text-cyan-300 font-bold\">{transactionId}</span> — Deep chronological forensics, behavioral anomaly isolation, and counterfactual stress testing.\n            </p>\n          </div>\n\n          {/* Navigation Sub-Tabs */}\n          <div className=\"flex items-center bg-slate-900 border border-slate-700/80 rounded-lg p-1 text-xs\">\n            <button\n              onClick={() => setActiveSubTab('timeline')}\n              className={`px-3 py-1.5 rounded-md font-medium transition ${\n                activeSubTab === 'timeline'\n                  ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30'\n                  : 'text-slate-400 hover:text-slate-200'\n              }`}\n            >\n              Timeline Replay\n            </button>\n            <button\n              onClick={() => setActiveSubTab('behavior')}\n              className={`px-3 py-1.5 rounded-md font-medium transition ${\n                activeSubTab === 'behavior'\n                  ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30'\n                  : 'text-slate-400 hover:text-slate-200'\n              }`}\n            >\n              Behavioral Drift\n            </button>\n            <button\n              onClick={() => setActiveSubTab('counterfactual')}\n              className={`px-3 py-1.5 rounded-md font-medium transition ${\n                activeSubTab === 'counterfactual'\n                  ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30'\n                  : 'text-slate-400 hover:text-slate-200'\n              }`}\n            >\n              What-If Simulator\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* SUB-TAB 1: Chronological Replay Timeline */}\n      {activeSubTab === 'timeline' && (\n        <div className=\"space-y-4\">\n          <div className=\"flex items-center justify-between text-xs text-slate-400 px-1\">\n            <span className=\"font-mono\">\n              Displaying {timelineEvents.length} account events in chronological order.\n            </span>\n            <div className=\"flex items-center gap-4 text-[11px] font-mono\">\n              <span className=\"flex items-center gap-1.5 text-teal-400\">\n                <span className=\"w-2 h-2 rounded-full bg-teal-400\" />\n                Historical Evidence (Prediction Time)\n              </span>\n              <span className=\"flex items-center gap-1.5 text-amber-400\">\n                <span className=\"w-2 h-2 rounded-full bg-amber-400\" />\n                Subsequent Event (Potential Lookahead Leakage)\n              </span>\n            </div>\n          </div>\n\n          <div className=\"relative pl-6 space-y-4 before:content-[''] before:absolute before:left-2.5 before:top-3 before:bottom-3 before:w-0.5 before:bg-slate-700/80\">\n            {timelineEvents.map((ev) => {\n              const isTarget = ev.is_target;\n              const isPrior = ev.leakage_classification === 'HISTORICAL_AVAILABLE_AT_PREDICTION';\n\n              return (\n                <div\n                  key={ev.transaction_id}\n                  onClick={() => onSelectTransaction(ev.transaction_id)}\n                  className={`relative p-4 rounded-xl border transition cursor-pointer ${\n                    isTarget\n                      ? 'bg-cyan-950/40 border-cyan-500/70 shadow-lg shadow-cyan-950/50'\n                      : 'bg-slate-850 hover:bg-slate-800 border-slate-700/80'\n                  }`}\n                >\n                  {/* Timeline Bullet */}\n                  <div\n                    className={`absolute -left-6 top-5 w-4 h-4 rounded-full border-2 -translate-x-1/2 flex items-center justify-center ${\n                      isTarget\n                        ? 'bg-cyan-400 border-navy-900 ring-4 ring-cyan-500/30'\n                        : isPrior\n                        ? 'bg-teal-400 border-navy-900'\n                        : 'bg-amber-400 border-navy-900'\n                    }`}\n                  />\n\n                  <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs\">\n                    <div className=\"flex items-center gap-3\">\n                      <span className=\"font-mono font-bold text-slate-100\">{ev.transaction_id}</span>\n                      {isTarget && (\n                        <span className=\"px-2 py-0.5 rounded bg-cyan-950 text-cyan-300 font-mono text-[10px] font-bold border border-cyan-800\">\n                          TARGET ALERT\n                        </span>\n                      )}\n                      <span\n                        className={`text-[10px] font-mono px-2 py-0.5 rounded ${\n                          isPrior ? 'text-teal-400 bg-teal-950/60' : 'text-amber-400 bg-amber-950/60'\n                        }`}\n                      >\n                        {isPrior ? 'Prior Baseline Event' : 'Later Observation'}\n                      </span>\n                    </div>\n\n                    <div className=\"flex items-center gap-4 font-mono\">\n                      <span className=\"text-slate-400\">{ev.timestamp}</span>\n                      <span className=\"text-sm font-bold text-slate-100\">${ev.amount.toFixed(2)}</span>\n                      <span\n                        className={`font-semibold ${\n                          ev.risk_score >= 65 ? 'text-rose-400' : 'text-teal-400'\n                        }`}\n                      >\n                        Score: {ev.risk_score?.toFixed(1) || 'N/A'}\n                      </span>\n                    </div>\n                  </div>\n\n                  <div className=\"mt-2 text-slate-400 text-[11px] grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2 border-t border-slate-800\">\n                    <div>\n                      Category: <span className=\"text-slate-200 capitalize\">{ev.merchant_category}</span>\n                    </div>\n                    <div>\n                      Device: <span className=\"text-slate-200 font-mono\">{ev.device_id}</span>\n                    </div>\n                    <div>\n                      Triage: <span className=\"text-slate-200\">{ev.triage_category}</span>\n                    </div>\n                    <div>\n                      Leakage Check: <span className=\"text-slate-300 font-mono\">{ev.leakage_classification}</span>\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      )}\n\n      {/* SUB-TAB 2: Behavioral Drift / Anomaly Isolation */}\n      {activeSubTab === 'behavior' && (\n        <div className=\"space-y-6\">\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n            <div className=\"bg-slate-850 p-4 rounded-xl border border-slate-700/80\">\n              <span className=\"text-[11px] text-slate-400 font-mono block\">VERIFIED HISTORICAL AVG</span>\n              <span className=\"text-2xl font-bold font-mono text-slate-100 mt-1 block\">\n                ${histAvg.toFixed(2)}\n              </span>\n              <span className=\"text-[10px] text-slate-400 mt-1 block\">Account verified benchmark</span>\n            </div>\n\n            <div className=\"bg-slate-850 p-4 rounded-xl border border-slate-700/80\">\n              <span className=\"text-[11px] text-slate-400 font-mono block\">CURRENT TRANSACTION</span>\n              <span className=\"text-2xl font-bold font-mono text-cyan-300 mt-1 block\">\n                ${currAmount.toFixed(2)}\n              </span>\n              <span className=\"text-[10px] text-slate-400 mt-1 block\">\n                Ratio: {(currAmount / Math.max(histAvg, 1)).toFixed(1)}x baseline\n              </span>\n            </div>\n\n            <div className=\"bg-slate-850 p-4 rounded-xl border border-slate-700/80\">\n              <span className=\"text-[11px] text-slate-400 font-mono block\">DRIFT SEVERITY</span>\n              <span\n                className={`text-2xl font-bold font-mono mt-1 block ${\n                  currAmount / Math.max(histAvg, 1) >= 3.0 ? 'text-rose-400' : 'text-teal-400'\n                }`}\n              >\n                {currAmount / Math.max(histAvg, 1) >= 3.0 ? 'SIGNIFICANT' : 'NOMINAL'}\n              </span>\n              <span className=\"text-[10px] text-slate-400 mt-1 block\">Neutral statistical evaluation</span>\n            </div>\n          </div>\n\n          <div className=\"bg-slate-850 border border-slate-700/80 rounded-xl p-5 space-y-4\">\n            <h2 className=\"text-sm font-bold text-slate-200 flex items-center gap-2\">\n              <TrendingUp className=\"w-4 h-4 text-teal-400\" />\n              Documented Behavioral Anomaly Breakdown\n            </h2>\n\n            <div className=\"space-y-3\">\n              {behavioralChanges.map((change, idx) => (\n                <div\n                  key={idx}\n                  className=\"p-3.5 bg-slate-900 rounded-lg border border-slate-800 space-y-1.5 text-xs\"\n                >\n                  <div className=\"flex items-center justify-between font-mono font-bold text-cyan-300\">\n                    <span>{change.signal}</span>\n                    <span className=\"text-[10px] font-normal text-slate-400\">Signal #{idx + 1}</span>\n                  </div>\n                  <p className=\"text-slate-200 font-medium\">{change.observation}</p>\n                  <div className=\"p-2 rounded bg-slate-850/80 border border-slate-800 text-[11px] text-slate-400 flex items-start gap-2\">\n                    <Info className=\"w-3.5 h-3.5 text-slate-400 shrink-0 mt-0.5\" />\n                    <span>{change.neutral_assessment}</span>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* SUB-TAB 3: Interactive What-If Counterfactual Simulator */}\n      {activeSubTab === 'counterfactual' && (\n        <div className=\"space-y-6\">\n          <div className=\"bg-slate-850 border border-slate-700/80 rounded-xl p-5 space-y-4\">\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n              <div>\n                <h2 className=\"text-sm font-bold text-slate-200 flex items-center gap-2\">\n                  <Sliders className=\"w-4 h-4 text-cyan-400\" />\n                  What-If Counterfactual Signal Modeler\n                </h2>\n                <p className=\"text-xs text-slate-400 mt-0.5\">\n                  Simulate alternative realities: \"What if the amount were closer to historical average?\" or \"What if failed logins were zero?\"\n                </p>\n              </div>\n\n              <button\n                onClick={handleRunCounterfactual}\n                disabled={cfLoading}\n                className=\"px-4 py-2 rounded-lg bg-cyan-600 hover:bg-cyan-500 font-semibold text-white text-xs flex items-center gap-2 transition active:scale-95 shrink-0\"\n              >\n                <Sparkles className=\"w-3.5 h-3.5\" />\n                {cfLoading ? 'Re-scoring Model...' : 'Recalculate Output'}\n              </button>\n            </div>\n\n            {/* Signal Control Sliders */}\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 pt-2\">\n              {/* Amount Slider */}\n              <div className=\"p-4 bg-slate-900 rounded-xl border border-slate-800 space-y-2\">\n                <div className=\"flex justify-between text-xs font-mono\">\n                  <span className=\"text-slate-400\">Simulated Amount</span>\n                  <span className=\"text-cyan-300 font-bold\">${cfAmount.toFixed(2)}</span>\n                </div>\n                <input\n                  type=\"range\"\n                  min=\"20\"\n                  max=\"4000\"\n                  step=\"20\"\n                  value={cfAmount}\n                  onChange={(e) => setCfAmount(parseFloat(e.target.value))}\n                  className=\"w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400\"\n                />\n                <div className=\"flex justify-between text-[10px] text-slate-500 font-mono\">\n                  <span>$20 (Micro)</span>\n                  <span>Baseline: ${histAvg.toFixed(0)}</span>\n                  <span>$4,000 (Spike)</span>\n                </div>\n              </div>\n\n              {/* Failed Attempts Slider */}\n              <div className=\"p-4 bg-slate-900 rounded-xl border border-slate-800 space-y-2\">\n                <div className=\"flex justify-between text-xs font-mono\">\n                  <span className=\"text-slate-400\">Failed Attempts (24h)</span>\n                  <span className=\"text-amber-400 font-bold\">{cfFailedAttempts} attempts</span>\n                </div>\n                <input\n                  type=\"range\"\n                  min=\"0\"\n                  max=\"5\"\n                  step=\"1\"\n                  value={cfFailedAttempts}\n                  onChange={(e) => setCfFailedAttempts(parseInt(e.target.value))}\n                  className=\"w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-amber-400\"\n                />\n                <div className=\"flex justify-between text-[10px] text-slate-500 font-mono\">\n                  <span>0 (Smooth login)</span>\n                  <span>2 (Warning)</span>\n                  <span>5 (Brute Force)</span>\n                </div>\n              </div>\n\n              {/* Merchant Category Select */}\n              <div className=\"p-4 bg-slate-900 rounded-xl border border-slate-800 space-y-2 text-xs\">\n                <label className=\"text-slate-400 font-mono block\">Merchant Risk Classification</label>\n                <select\n                  value={cfCategory}\n                  onChange={(e) => setCfCategory(e.target.value)}\n                  className=\"w-full bg-slate-850 border border-slate-700 rounded-lg p-2 text-slate-100 outline-none cursor-pointer\"\n                >\n                  <option value=\"grocery\">Grocery (Low Risk - 0.05)</option>\n                  <option value=\"fast_food\">Fast Food (Low Risk - 0.10)</option>\n                  <option value=\"electronics\">Electronics (Medium - 0.50)</option>\n                  <option value=\"luxury_goods\">Luxury Goods (High - 0.65)</option>\n                  <option value=\"crypto_exchange\">Crypto Exchange (Critical - 0.85)</option>\n                </select>\n                <p className=\"text-[10px] text-slate-500 font-mono\">\n                  Adjusts empirical sector exposure.\n                </p>\n              </div>\n            </div>\n\n            {/* Re-scoring Comparison Output */}\n            {cfResult && (\n              <div className=\"p-5 bg-navy-900 rounded-xl border border-cyan-500/40 space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <h3 className=\"text-xs font-bold font-mono text-cyan-300 uppercase tracking-wider\">\n                    Model Output Comparison\n                  </h3>\n                  <span className=\"text-[10px] font-mono text-slate-400\">\n                    Version: {cfResult.model_version}\n                  </span>\n                </div>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 text-center\">\n                  <div className=\"p-3 bg-slate-900 rounded-lg border border-slate-800\">\n                    <span className=\"text-[11px] text-slate-400 block font-mono\">ORIGINAL RISK SCORE</span>\n                    <span className=\"text-2xl font-bold font-mono text-slate-200 mt-1 block\">\n                      {cfResult.original_risk_score.toFixed(1)}\n                    </span>\n                    <span className=\"text-[10px] text-slate-400 block mt-0.5\">\n                      {cfResult.original_category}\n                    </span>\n                  </div>\n\n                  <div className=\"p-3 bg-slate-900 rounded-lg border border-slate-800\">\n                    <span className=\"text-[11px] text-slate-400 block font-mono\">MODIFIED RISK SCORE</span>\n                    <span className=\"text-2xl font-bold font-mono text-cyan-300 mt-1 block\">\n                      {cfResult.modified_risk_score.toFixed(1)}\n                    </span>\n                    <span className=\"text-[10px] text-cyan-400 block mt-0.5\">\n                      {cfResult.modified_category}\n                    </span>\n                  </div>\n\n                  <div className=\"p-3 bg-slate-900 rounded-lg border border-slate-800\">\n                    <span className=\"text-[11px] text-slate-400 block font-mono\">SCORE DELTA</span>\n                    <span\n                      className={`text-2xl font-bold font-mono mt-1 block ${\n                        cfResult.risk_score_delta < 0\n                          ? 'text-emerald-400'\n                          : cfResult.risk_score_delta > 0\n                          ? 'text-rose-400'\n                          : 'text-slate-300'\n                      }`}\n                    >\n                      {cfResult.risk_score_delta > 0 ? `+${cfResult.risk_score_delta}` : cfResult.risk_score_delta}\n                    </span>\n                    <span className=\"text-[10px] text-slate-400 block mt-0.5\">\n                      {cfResult.risk_score_delta < 0 ? 'Risk Reduced' : 'Risk Elevated'}\n                    </span>\n                  </div>\n                </div>\n\n                {/* Explicit Interpretability & Causality Caution Banner */}\n                <div className=\"p-3 bg-amber-950/40 rounded-lg border border-amber-800/60 flex items-start gap-2.5 text-xs text-amber-300\">\n                  <AlertCircle className=\"w-4 h-4 text-amber-400 shrink-0 mt-0.5\" />\n                  <p className=\"leading-relaxed text-[11px]\">\n                    <strong className=\"font-bold\">Interpretability & Safety Notice: </strong>\n                    {cfResult.interpretability_warning}\n                  </p>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n","Overwrite":true,"Path":"C:\\Users\\S Nandhakumar\\.gemini\\antigravity\\scratch\\fraudlens-ai\\frontend\\src\\components\\ReplayLab.tsx"}}]}
{"step_index":409,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-29T13:47:48Z","content":"Created At: 2026-10-29T19:17:48+05:30\nCompleted At: 2026-10-29T19:17:48+05:30\nCreated file."}
{"step_index":410,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-29T13:47:48Z","input_tokens":6388,"cache_read_tokens":207741,"output_tokens":3747,"thinking":"Fraud Network Radar component construction will focus on visually representing relationships between transactions, accounts, merchants, devices, and IPs using an interactive graph like Cytoscape.js. The primary goal is to highlight suspicious patterns like shared devices, IP reuse, rapid transaction bursts, and connections to potentially fraudulent activity clusters, displaying the reasoning behind each connection with clear evidence. The component must also accurately distinguish observed relationships from mere coincidences.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import React, { useEffect, useRef, useState } from 'react';\nimport cytoscape from 'cytoscape';\nimport {\n  Share2,\n  ShieldAlert,\n  Info,\n  Maximize2,\n  RefreshCw,\n  Users,\n  Smartphone,\n  Globe,\n  Store,\n  DollarSign\n} from 'lucide-react';\nimport { EgoGraphData, SyndicateCluster } from '../types';\nimport { api } from '../services/api';\n\ninterface FraudNetworkRadarProps {\n  transactionId: string;\n  onSelectTransaction: (id: string) => void;\n}\n\nexport const FraudNetworkRadar: React.FC<FraudNetworkRadarProps> = ({\n  transactionId,\n  onSelectTransaction,\n}) => {\n  const containerRef = useRef<HTMLDivElement>(null);\n  const cyRef = useRef<cytoscape.Core | null>(null);\n\n  const [graphData, setGraphData] = useState<EgoGraphData | null>(null);\n  const [syndicates, setSyndicates] = useState<SyndicateCluster[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [selectedElement, setSelectedElement] = useState<any>(null);\n\n  const loadGraph = async () => {\n    setLoading(true);\n    try {\n      const [ego, syn] = await Promise.all([\n        api.getEgoGraph(transactionId, 2),\n        api.getSyndicates()\n      ]);\n      setGraphData(ego);\n      setSyndicates(syn.syndicates);\n    } catch (err) {\n      console.error(err);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    loadGraph();\n  }, [transactionId]);\n\n  useEffect(() => {\n    if (!containerRef.current || !graphData) return;\n\n    // Build Cytoscape elements\n    const elements: any[] = [];\n\n    // Add nodes with custom styles\n    graphData.nodes.forEach((node) => {\n      let bg = '#3B82F6';\n      let shape = 'ellipse';\n      let size = 35;\n\n      if (node.node_type === 'transaction') {\n        bg = node.id === transactionId ? '#EF4444' : '#06B6D4';\n        shape = 'diamond';\n        size = node.id === transactionId ? 45 : 35;\n      } else if (node.node_type === 'device') {\n        bg = (node.account_count || 0) > 1 ? '#F59E0B' : '#64748B';\n        shape = 'rectangle';\n        size = 35;\n      } else if (node.node_type === 'ip') {\n        bg = '#14B8A6';\n        shape = 'hexagon';\n        size = 32;\n      } else if (node.node_type === 'account') {\n        bg = '#8B5CF6';\n        shape = 'ellipse';\n        size = 40;\n      } else if (node.node_type === 'merchant') {\n        bg = '#10B981';\n        shape = 'triangle';\n        size = 35;\n      }\n\n      elements.push({\n        data: {\n          id: node.id,\n          label: node.label || node.id,\n          nodeType: node.node_type,\n          bgColor: bg,\n          shape: shape,\n          size: size,\n          raw: node\n        }\n      });\n    });\n\n    // Add edges\n    graphData.edges.forEach((edge, idx) => {\n      elements.push({\n        data: {\n          id: `edge-${idx}`,\n          source: edge.source,\n          target: edge.target,\n          relation: edge.relation,\n          evidence: edge.evidence\n        }\n      });\n    });\n\n    // Destroy previous instance\n    if (cyRef.current) {\n      cyRef.current.destroy();\n    }\n\n    const cy = cytoscape({\n      container: containerRef.current,\n      elements: elements,\n      style: [\n        {\n          selector: 'node',\n          style: {\n            'background-color': 'data(bgColor)',\n            'label': 'data(label)',\n            'color': '#F1F5F9',\n            'font-size': '10px',\n            'text-valign': 'bottom',\n            'text-margin-y': 4,\n            'width': 'data(size)',\n            'height': 'data(size)',\n            'shape': 'data(shape)' as any,\n            'border-width': 2,\n            'border-color': '#0F172A'\n          }\n        },\n        {\n          selector: 'edge',\n          style: {\n            'width': 1.5,\n            'line-color': '#334155',\n            'target-arrow-color': '#334155',\n            'target-arrow-shape': 'triangle',\n            'curve-style': 'bezier',\n            'opacity': 0.7\n          }\n        },\n        {\n          selector: ':selected',\n          style: {\n            'border-width': 4,\n            'border-color': '#38BDF8',\n            'line-color': '#38BDF8',\n            'target-arrow-color': '#38BDF8',\n            'opacity': 1\n          }\n        }\n      ],\n      layout: {\n        name: 'cose',\n        animate: false,\n        nodeDimensionsIncludeLabels: true,\n        padding: 40\n      }\n    });\n\n    cy.on('tap', 'node', (evt) => {\n      const node = evt.target;\n      setSelectedElement({ type: 'node', ...node.data() });\n    });\n\n    cy.on('tap', 'edge', (evt) => {\n      const edge = evt.target;\n      setSelectedElement({ type: 'edge', ...edge.data() });\n    });\n\n    cyRef.current = cy;\n\n    return () => {\n      if (cyRef.current) cyRef.current.destroy();\n    };\n  }, [graphData]);\n\n  const fitGraph = () => {\n    if (cyRef.current) {\n      cyRef.current.fit();\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Top Banner */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-slate-700/60\">\n        <div>\n          <h1 className=\"text-xl font-bold tracking-tight text-slate-100 flex items-center gap-2\">\n            <Share2 className=\"w-5 h-5 text-cyan-400\" />\n            Fraud Network Radar & Syndicate Detection\n          </h1>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            NetworkX multi-entity relational topology: identifies shared hardware fingerprints, IP proxy clusters, and mule rings.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={fitGraph}\n            className=\"px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 text-xs flex items-center gap-1.5 transition\"\n          >\n            <Maximize2 className=\"w-3.5 h-3.5\" />\n            <span>Reset Zoom</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Main Dual Workspace */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-4 gap-6\">\n        {/* Cytoscape Canvas (3 cols) */}\n        <div className=\"lg:col-span-3 bg-navy-950 border border-slate-700/80 rounded-xl overflow-hidden relative shadow-inner h-[540px]\">\n          {loading && (\n            <div className=\"absolute inset-0 bg-navy-950/80 backdrop-blur-sm flex items-center justify-center font-mono text-xs text-cyan-400 z-10\">\n              <RefreshCw className=\"w-4 h-4 animate-spin mr-2\" />\n              Computing NetworkX connected components...\n            </div>\n          )}\n\n          {/* Graph Legend */}\n          <div className=\"absolute top-3 left-3 bg-slate-900/90 border border-slate-800 rounded-lg p-2.5 text-[10px] font-mono space-y-1.5 z-10 backdrop-blur-md\">\n            <div className=\"text-slate-400 font-bold uppercase tracking-wider mb-1\">Entity Map</div>\n            <div className=\"flex items-center gap-2 text-slate-300\">\n              <span className=\"w-2.5 h-2.5 rounded-sm bg-rose-500\" /> Target Txn (Diamond)\n            </div>\n            <div className=\"flex items-center gap-2 text-slate-300\">\n              <span className=\"w-2.5 h-2.5 rounded-full bg-purple-500\" /> Account (Circle)\n            </div>\n            <div className=\"flex items-center gap-2 text-slate-300\">\n              <span className=\"w-2.5 h-2.5 rounded-sm bg-amber-500\" /> Shared Device (Square)\n            </div>\n            <div className=\"flex items-center gap-2 text-slate-300\">\n              <span className=\"w-2.5 h-2.5 rounded-sm bg-teal-500\" /> IP Address (Hex)\n            </div>\n            <div className=\"flex items-center gap-2 text-slate-300\">\n              <span className=\"w-2.5 h-2.5 rounded-sm bg-emerald-500\" /> Merchant (Triangle)\n            </div>\n          </div>\n\n          <div ref={containerRef} className=\"w-full h-full cursor-grab active:cursor-grabbing\" />\n        </div>\n\n        {/* Selected Entity & Syndicate Sidebar (1 col) */}\n        <div className=\"space-y-4\">\n          {/* Selected Element Evidence Inspector */}\n          <div className=\"bg-slate-850 border border-slate-700/80 rounded-xl p-4 text-xs space-y-3\">\n            <h3 className=\"font-bold font-mono text-slate-200 uppercase tracking-wider text-[11px] flex items-center gap-1.5\">\n              <Info className=\"w-3.5 h-3.5 text-cyan-400\" />\n              Entity & Evidence Inspector\n            </h3>\n\n            {selectedElement ? (\n              <div className=\"space-y-2\">\n                <div className=\"p-2.5 bg-slate-900 rounded-lg border border-slate-800 space-y-1\">\n                  <span className=\"text-[10px] text-slate-500 font-mono block uppercase\">\n                    {selectedElement.type === 'node' ? `Node: ${selectedElement.nodeType}` : 'Relationship Edge'}\n                  </span>\n                  <span className=\"font-mono font-bold text-cyan-300 block break-all\">\n                    {selectedElement.id}\n                  </span>\n                  {selectedElement.relation && (\n                    <span className=\"text-teal-400 font-mono text-[10px] block\">\n                      Relation: {selectedElement.relation}\n                    </span>\n                  )}\n                </div>\n\n                {selectedElement.evidence && (\n                  <div className=\"p-2.5 bg-slate-900 rounded-lg border border-slate-800 space-y-1\">\n                    <span className=\"text-[10px] text-slate-400 font-mono block\">EVIDENCE JUSTIFICATION</span>\n                    <p className=\"text-slate-300 text-[11px] leading-relaxed\">\n                      {selectedElement.evidence}\n                    </p>\n                  </div>\n                )}\n\n                {selectedElement.nodeType === 'transaction' && (\n                  <button\n                    onClick={() => onSelectTransaction(selectedElement.id)}\n                    className=\"w-full py-1.5 rounded bg-cyan-600 hover:bg-cyan-500 text-white font-medium text-xs transition\"\n                  >\n                    Open Transaction Profile\n                  </button>\n                )}\n              </div>\n            ) : (\n              <p className=\"text-slate-400 text-[11px] leading-relaxed\">\n                Click on any node or edge in the radar graph to view underlying relationship evidence and verification telemetry.\n              </p>\n            )}\n          </div>\n\n          {/* Known Syndicate Clusters List */}\n          <div className=\"bg-slate-850 border border-slate-700/80 rounded-xl p-4 text-xs space-y-3\">\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"font-bold font-mono text-slate-200 uppercase tracking-wider text-[11px] flex items-center gap-1.5\">\n                <Users className=\"w-3.5 h-3.5 text-amber-400\" />\n                Discovered Syndicates\n              </h3>\n              <span className=\"text-[10px] font-mono px-1.5 py-0.5 rounded bg-amber-950 text-amber-300 border border-amber-800\">\n                {syndicates.length} Rings\n              </span>\n            </div>\n\n            <div className=\"space-y-2 max-h-56 overflow-y-auto pr-1\">\n              {syndicates.map((syn, i) => (\n                <div\n                  key={i}\n                  className=\"p-2.5 bg-slate-900 rounded-lg border border-slate-800 space-y-1\"\n                >\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"font-mono text-[11px] font-bold text-amber-400\">\n                      {syn.entity_id}\n                    </span>\n                    <span className=\"text-[9px] font-mono text-rose-400 font-bold\">\n                      {syn.risk_level}\n                    </span>\n                  </div>\n                  <p className=\"text-slate-300 text-[11px] leading-tight\">\n                    {syn.narrative}\n                  </p>\n                </div>\n              ))}\n            </div>\n\n            {/* Inferred vs Observed Disclaimer */}\n            <div className=\"p-2 bg-slate-900/60 rounded border border-slate-800 text-[10px] text-slate-500 leading-tight\">\n              Notice: Graph edges represent observed empirical links (e.g. shared device ID). A shared device alone is not legal proof of fraud.\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n","Overwrite":true,"Path":"C:\\Users\\S Nandhakumar\\.gemini\\antigravity\\scratch\\fraudlens-ai\\frontend\\src\\components\\FraudNetworkRadar.tsx"}}]}
{"step_index":411,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-29T13:48:16Z","content":"Created At: 2026-10-29T19:18:16+05:30\nCompleted At: 2026-10-29T19:18:16+05:30\nCreated file."}
{"step_index":412,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-29T13:48:16Z","input_tokens":3798,"cache_read_tokens":214154,"output_tokens":3367,"thinking":"Focus is now on the Model Evaluation component, specifically addressing seven key requirements. This involves comparing the champion model against a baseline and providing a comprehensive suite of metrics. The metrics will include a confusion matrix, various precision and recall measures, and the precision at a limited daily review capacity, along with a curve for decision threshold tuning. Clear labeling of all generated metrics is essential.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import React from 'react';\nimport {\n  BarChart3,\n  Cpu,\n  Target,\n  Sliders,\n  CheckCircle,\n  AlertTriangle,\n  Award,\n  Layers,\n  ArrowRight\n} from 'lucide-react';\nimport { OverviewStatistics } from '../types';\n\ninterface ModelEvaluationProps {\n  stats: OverviewStatistics | null;\n}\n\nexport const ModelEvaluation: React.FC<ModelEvaluationProps> = ({ stats }) => {\n  if (!stats) {\n    return (\n      <div className=\"flex items-center justify-center h-96 font-mono text-cyan-400 text-sm\">\n        Loading verified performance evaluation data...\n      </div>\n    );\n  }\n\n  const { evaluation_metrics, thresholds, model_metadata } = stats;\n  const champ = evaluation_metrics.champion_model;\n  const base = evaluation_metrics.baseline_model;\n  const cm = champ.confusion_matrix;\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Top Banner */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-slate-700/60\">\n        <div>\n          <h1 className=\"text-xl font-bold tracking-tight text-slate-100 flex items-center gap-2\">\n            <BarChart3 className=\"w-5 h-5 text-cyan-400\" />\n            Model Performance & Decision Boundary Evaluation\n          </h1>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Empirical metrics measured on {evaluation_metrics.held_out_test_records} held-out chronological test transactions. Never fabricated.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <span className=\"px-3 py-1 rounded bg-teal-950 text-teal-300 border border-teal-800 text-xs font-mono font-bold flex items-center gap-1.5\">\n            <CheckCircle className=\"w-3.5 h-3.5 text-teal-400\" />\n            Chronological Split (Zero Lookahead)\n          </span>\n        </div>\n      </div>\n\n      {/* Model Benchmark Comparison Table (Champion vs Baseline) */}\n      <div className=\"bg-slate-850 border border-slate-700/80 rounded-xl p-5 space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <h2 className=\"text-sm font-bold text-slate-200 flex items-center gap-2\">\n            <Award className=\"w-4 h-4 text-cyan-400\" />\n            Champion vs Baseline Benchmark Comparison\n          </h2>\n          <span className=\"text-xs font-mono text-slate-400\">Held-Out Test Set</span>\n        </div>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left border-collapse text-xs\">\n            <thead>\n              <tr className=\"bg-slate-900/90 text-slate-400 font-mono text-[11px] border-b border-slate-700\">\n                <th className=\"py-2.5 px-4\">MODEL PIPELINE</th>\n                <th className=\"py-2.5 px-4\">ALGORITHM</th>\n                <th className=\"py-2.5 px-4 text-right\">PRECISION</th>\n                <th className=\"py-2.5 px-4 text-right\">RECALL</th>\n                <th className=\"py-2.5 px-4 text-right\">F1 SCORE</th>\n                <th className=\"py-2.5 px-4 text-right\">ROC-AUC</th>\n                <th className=\"py-2.5 px-4 text-center\">STATUS</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800 font-mono\">\n              <tr className=\"bg-cyan-950/20 text-slate-100 font-medium\">\n                <td className=\"py-3 px-4 font-bold text-cyan-300 flex items-center gap-2\">\n                  <span className=\"w-2 h-2 rounded-full bg-cyan-400 animate-pulse\" />\n                  Champion Pipeline\n                </td>\n                <td className=\"py-3 px-4 text-slate-300 font-sans text-xs\">\n                  {champ.algorithm}\n                </td>\n                <td className=\"py-3 px-4 text-right font-bold text-teal-400\">\n                  {(champ.precision * 100).toFixed(1)}%\n                </td>\n                <td className=\"py-3 px-4 text-right font-bold text-teal-400\">\n                  {(champ.recall * 100).toFixed(1)}%\n                </td>\n                <td className=\"py-3 px-4 text-right font-bold text-cyan-300 text-sm\">\n                  {champ.f1_score.toFixed(3)}\n                </td>\n                <td className=\"py-3 px-4 text-right font-bold text-slate-200\">\n                  {champ.roc_auc.toFixed(3)}\n                </td>\n                <td className=\"py-3 px-4 text-center\">\n                  <span className=\"px-2 py-0.5 rounded bg-teal-950 text-teal-300 border border-teal-800 text-[10px] uppercase font-bold\">\n                    Active Deployment\n                  </span>\n                </td>\n              </tr>\n              <tr className=\"text-slate-400\">\n                <td className=\"py-3 px-4 text-slate-300 font-medium\">\n                  Baseline Pipeline\n                </td>\n                <td className=\"py-3 px-4 text-slate-400 font-sans text-xs\">\n                  {base.algorithm}\n                </td>\n                <td className=\"py-3 px-4 text-right\">\n                  {(base.precision * 100).toFixed(1)}%\n                </td>\n                <td className=\"py-3 px-4 text-right\">\n                  {(base.recall * 100).toFixed(1)}%\n                </td>\n                <td className=\"py-3 px-4 text-right\">\n                  {base.f1_score.toFixed(3)}\n                </td>\n                <td className=\"py-3 px-4 text-right\">\n                  {base.roc_auc.toFixed(3)}\n                </td>\n                <td className=\"py-3 px-4 text-center\">\n                  <span className=\"px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700 text-[10px] uppercase\">\n                    Benchmark Reference\n                  </span>\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* Dual Pane: Confusion Matrix & Review Capacity Efficiency */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        {/* 2x2 Confusion Matrix */}\n        <div className=\"bg-slate-850 border border-slate-700/80 rounded-xl p-5 space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <h2 className=\"text-sm font-bold text-slate-200 flex items-center gap-2\">\n              <Target className=\"w-4 h-4 text-teal-400\" />\n              Held-Out Test Set Confusion Matrix\n            </h2>\n            <span className=\"text-[11px] font-mono text-slate-400\">\n              N = {evaluation_metrics.held_out_test_records}\n            </span>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-3 text-center\">\n            {/* True Negative */}\n            <div className=\"p-4 bg-slate-900 rounded-xl border border-slate-800\">\n              <span className=\"text-[10px] font-mono uppercase text-slate-400 block mb-1\">\n                True Negatives (TN)\n              </span>\n              <span className=\"text-2xl font-bold font-mono text-emerald-400\">\n                {cm.true_negative}\n              </span>\n              <span className=\"text-[11px] text-slate-400 block mt-1\">\n                Legitimate accurately cleared\n              </span>\n            </div>\n\n            {/* False Positive */}\n            <div className=\"p-4 bg-slate-900 rounded-xl border border-slate-800\">\n              <span className=\"text-[10px] font-mono uppercase text-slate-400 block mb-1\">\n                False Positives (FP)\n              </span>\n              <span className=\"text-2xl font-bold font-mono text-amber-400\">\n                {cm.false_positive}\n              </span>\n              <span className=\"text-[11px] text-slate-400 block mt-1\">\n                False alarms needing triage\n              </span>\n            </div>\n\n            {/* False Negative */}\n            <div className=\"p-4 bg-slate-900 rounded-xl border border-slate-800\">\n              <span className=\"text-[10px] font-mono uppercase text-slate-400 block mb-1\">\n                False Negatives (FN)\n              </span>\n              <span className=\"text-2xl font-bold font-mono text-rose-400\">\n                {cm.false_negative}\n              </span>\n              <span className=\"text-[11px] text-slate-400 block mt-1\">\n                Missed fraudulent events\n              </span>\n            </div>\n\n            {/* True Positive */}\n            <div className=\"p-4 bg-slate-900 rounded-xl border border-slate-800\">\n              <span className=\"text-[10px] font-mono uppercase text-slate-400 block mb-1\">\n                True Positives (TP)\n              </span>\n              <span className=\"text-2xl font-bold font-mono text-cyan-400\">\n                {cm.true_positive}\n              </span>\n              <span className=\"text-[11px] text-slate-400 block mt-1\">\n                Fraud intercepted by pipeline\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Operational Review Capacity & Threshold Configuration */}\n        <div className=\"bg-slate-850 border border-slate-700/80 rounded-xl p-5 space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <h2 className=\"text-sm font-bold text-slate-200 flex items-center gap-2\">\n              <Sliders className=\"w-4 h-4 text-cyan-400\" />\n              Tuned Operational Thresholds\n            </h2>\n            <span className=\"text-[11px] font-mono text-slate-400\">Validation Set Fitted</span>\n          </div>\n\n          <div className=\"space-y-4 text-xs\">\n            <div className=\"p-3.5 bg-slate-900 rounded-lg border border-slate-800 space-y-2\">\n              <div className=\"flex justify-between font-mono\">\n                <span className=\"text-slate-300 font-bold\">HIGH RISK THRESHOLD (tau_high)</span>\n                <span className=\"text-rose-400 font-bold\">{(thresholds.tau_high * 100).toFixed(0)}%</span>\n              </div>\n              <p className=\"text-slate-400 text-[11px]\">\n                Transactions at or above {(thresholds.tau_high * 100).toFixed(0)}% risk automatically enter high-priority queue. Fitted on validation split to optimize Precision-Recall balance.\n              </p>\n            </div>\n\n            <div className=\"p-3.5 bg-slate-900 rounded-lg border border-slate-800 space-y-2\">\n              <div className=\"flex justify-between font-mono\">\n                <span className=\"text-slate-300 font-bold\">LOWER RISK THRESHOLD (tau_low)</span>\n                <span className=\"text-emerald-400 font-bold\">{(thresholds.tau_low * 100).toFixed(0)}%</span>\n              </div>\n              <p className=\"text-slate-400 text-[11px]\">\n                Transactions below {(thresholds.tau_low * 100).toFixed(0)}% with low uncertainty are assigned standard continuous surveillance, preventing investigator fatigue.\n              </p>\n            </div>\n\n            <div className=\"p-3.5 bg-slate-900 rounded-lg border border-slate-800 space-y-2\">\n              <div className=\"flex justify-between font-mono\">\n                <span className=\"text-slate-300 font-bold\">UNCERTAIN AMBIGUITY BAND</span>\n                <span className=\"text-amber-400 font-bold\">\n                  {(thresholds.tau_low * 100).toFixed(0)}% – {(thresholds.tau_high * 100).toFixed(0)}%\n                </span>\n              </div>\n              <p className=\"text-slate-400 text-[11px]\">\n                Predictions falling near the 50% decision boundary or exhibiting model disagreement trigger secondary investigator review.\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n","Overwrite":true,"Path":"C:\\Users\\S Nandhakumar\\.gemini\\antigravity\\scratch\\fraudlens-ai\\frontend\\src\\components\\ModelEvaluation.tsx"}}]}
