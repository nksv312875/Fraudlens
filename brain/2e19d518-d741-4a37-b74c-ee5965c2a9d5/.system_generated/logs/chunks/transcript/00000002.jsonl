]) == 3\\n    assert \\\"evaluation_metrics\\\" in data\\n    assert \\\"champion_model\\\" in data[\\\"evaluation_metrics\\\"]\\n\\ndef test_api_queue_sorting_and_filtering():\\n    # Filter HIGH RISK only\\n    response = client.get(\\\"/api/queue?triage_category=HIGH%20RISK&limit=10\\\")\\n    assert response.status_code == 200\\n    data = response.json()\\n    for item in data[\\\"items\\\"]:\\n        assert item[\\\"triage_category\\\"] == \\\"HIGH RISK\\\"\\n\\n    # Sort by amount descending\\n    response_amt = client.get(\\\"/api/queue?sort_by=amount&ascending=false&limit=5\\\")\\n    assert response_amt.status_code == 200\\n    items = response_amt.json()[\\\"items\\\"]\\n    amounts = [i[\\\"amount\\\"] for i in items]\\n    assert amounts == sorted(amounts,\n<truncated 3945 bytes>","Overwrite":"true","Path":"\"C:\\\\Users\\\\S Nandhakumar\\\\.gemini\\\\antigravity\\\\scratch\\\\fraudlens-ai\\\\backend\\\\tests\\\\test_api_and_ml.py\""}}],"truncated_fields":["tool_calls"]}
