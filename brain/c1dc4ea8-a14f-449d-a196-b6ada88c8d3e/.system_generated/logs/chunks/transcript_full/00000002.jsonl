ice_id: Optional[str] = Field(default=\"DEV-DEFAULT\", example=\"DEV-ANOM-99\")\n    ip_address: Optional[str] = Field(default=\"198.51.100.1\", example=\"203.0.113.199\")\n    location_country: Optional[str] = Field(default=\"US\", example=\"US\")\n    account_age_days: Optional[int] = Field(default=90, example=120)\n    failed_attempts_last_24h: Optional[int] = Field(default=0, example=2)\n    timestamp: Optional[str] = None\n\nclass PredictionResponse(BaseModel):\n    transaction_id: str\n    risk_score: float\n    calibrated_probability: float\n    baseline_probability: float\n    triage_category: str\n    uncertainty_indicator: float\n    review_priority: float\n    recommended_action: str\n    model_version: str\n    feature_contributions: List[Dict[str, Any]]\n    raw_features: Dict[str, Any]\n\nclass CounterfactualRequest(BaseModel):\n    transaction_id: str\n    modified_amount: Optional[float] = None\n    modified_device_id: Optional[str] = None\n    modified_merchant_category: Optional[str] = None\n    modified_failed_attempts: Optional[int] = None\n    modified_country: Optional[str] = None\n\nclass CounterfactualResponse(BaseModel):\n    transaction_id: str\n    model_version: str\n    original_risk_score: float\n    modified_risk_score: float\n    risk_score_delta: float\n    original_category: str\n    modified_category: str\n    changed_inputs: Dict[str, Any]\n    interpretability_warning: str\n\nclass FeedbackSubmission(BaseModel):\n    transaction_id: str\n    decision: str = Field(..., example=\"confirmed_fraud\") # confirmed_fraud, legitimate, inconclusive, escalated\n    reviewer_name: str = Field(..., example=\"Lead Investigator\")\n    notes: Optional[str] = \"\"\n\nclass QueueSimulationRequest(BaseModel):\n    daily_review_capacity: int = Field(default=25, ge=5, le=200)"}}]}
