{"step_index":29,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-29T14:07:41Z","content":"Created At: 2026-10-29T19:37:41+05:30\nCompleted At: 2026-10-29T19:37:42+05:30\nShowing lines 1-130 of 130\n1: \"\"\"\n2: FraudLens AI - Automated Unit & Integration Test Suite\n3: Executes completely offline without socket bindings, guaranteeing 100% compatibility\n4: with sandboxed testing environments.\n5: \"\"\"\n6: \n7: import pytest\n8: import pandas as pd\n9: from app.api.endpoints import (\n10:     health_check, get_overview_statistics, get_investigation_queue,\n11:     get_transaction_detail, predict_single_transaction, simulate_counterfactual,\n12:     get_replay_timeline, get_behavioral_change_analysis, get_graph_ego,\n13:     get_graph_syndicates, submit_investigator_feedback, simulate_queue_capacity,\n14:     get_demo_scenarios\n15: )\n16: from app.schemas.transactions import (\n17:     TransactionPayload, CounterfactualRequest, FeedbackSubmission, QueueSimulationRequest\n18: )\n19: from app.ml.features import FeatureExtractor\n20: from app.graph.engine import FraudGraphEngine\n21: from app.db.repository import DatabaseManager, FeedbackRepository, TransactionRepository\n22: \n23: def test_health_check_endpoint():\n24:     res = health_check()\n25:     assert res[\"status\"] == \"healthy\"\n26:     assert \"model_version\" in res\n27:     assert res[\"synthetic_demo_badge\"] is True\n28: \n29: def test_overview_statistics():\n30:     res = get_overview_statistics()\n31:     assert \"summary\" in res\n32:     assert res[\"summary\"][\"total_analyzed\"] >= 2000\n33:     assert \"risk_distribution\" in res\n34:     assert len(res[\"risk_distribution\"]) == 3\n35:     assert \"evaluation_metrics\" in res\n36:     assert \"champion_model\" in res[\"evaluation_metrics\"]\n37: \n38: def test_queue_filtering_and_sorting():\n39:     # Filter HIGH RISK only\n40:     res_high = get_investigation_queue(triage_category=\"HIGH RISK\", limit=10)\n41:     for item in res_high[\"items\"]:\n42:         assert item[\"triage_category\"] == \"HIGH RISK\"\n43: \n44:     # Sort by amount descending\n45:     res_amt = get_investigation_queue(sort_by=\"amount\", ascending=False, limit=5)\n46:     amounts = [i[\"amount\"] for i in res_amt[\"items\"]]\n47:     assert amounts == sorted(amounts, reverse=True)\n48: \n49: def test_demo_case_a_legitimate_unusual():\n50:     res = get_transaction_detail(\"TXN-DEMO-A101\")\n51:     txn = res[\"transaction\"]\n52:     assert txn[\"transaction_id\"] == \"TXN-DEMO-A101\"\n53:     assert txn[\"amount\"] == 750.00\n54:     # Long-term account + trusted device: should NOT be high risk\n55:     assert txn[\"triage_category\"] in [\"LOWER RISK\", \"UNCERTAIN\"]\n56:     assert \"case_summary\" in res\n57:     assert len(res[\"case_summary\"][\"observed_evidence\"]) > 0\n58: \n59: def test_demo_case_b_account_takeover():\n60:     res = get_transaction_detail(\"TXN-DEMO-B202\")\n61:     txn = res[\"transaction\"]\n62:     assert txn[\"transaction_id\"] == \"TXN-DEMO-B202\"\n63:     # New device, foreign IP, 4 failed attempts -> HIGH RISK\n64:     assert txn[\"triage_category\"] == \"HIGH RISK\"\n65:     assert txn[\"risk_score\"] >= 80.0\n66:     reason_codes = [c[\"code\"] for c in txn[\"feature_contributions\"]]\n67:     assert \"FAILED_AUTH_BURST\" in reason_codes\n68:     assert \"FOREIGN_ORIGIN\" in reason_codes\n69: \n70: def test_demo_case_c_graph_syndicate():\n71:     res = get_graph_ego(\"TXN-DEMO-C301\", depth=2)\n72:     assert res[\"has_syndicate_overlap\"] is True\n73:     assert len(res[\"shared_devices\"]) > 0 or len(res[\"shared_ips\"]) > 0\n74: \n75: def test_counterfactual_simulator():\n76:     req = CounterfactualRequest(\n77:         transaction_id=\"TXN-DEMO-B202\",\n78:         modified_amount=95.00,\n79:         modified_failed_attempts=0,\n80:         modified_country=\"US\"\n81:     )\n82:     res = simulate_counterfactual(req)\n83:     assert res.transaction_id == \"TXN-DEMO-B202\"\n84:     assert res.modified_risk_score < res.original_risk_score\n85:     assert res.risk_score_delta < 0\n86:     assert \"Caution: Modifying an individual feature\" in res.interpretability_warning\n87: \n88: def test_feedback_submission_and_override():\n89:     sub = FeedbackSubmission(\n90:         transaction_id=\"TXN-DEMO-A101\",\n91:         decision=\"legitimate\",\n92:         reviewer_name=\"Automated Unit Test Agent\",\n93:         notes=\"Legitimate high spender on verified device.\"\n94:     )\n95:     res = submit_investigator_feedback(sub)\n96:     assert res[\"status\"] == \"success\"\n97:     assert res[\"recorded_feedback\"][\"decision\"] == \"legitimate\"\n98: \n99: def test_queue_simulation_capacity():\n100:     req = QueueSimulationRequest(daily_review_capacity=25)\n101:     res = simulate_queue_capacity(req)\n102:     assert res[\"daily_capacity\"] == 25\n103:     assert res[\"cases_reviewed\"] == 25\n104:     assert \"capacity_precision\" in res\n105: \n106: def test_behavioral_change_detector():\n107:     res = get_behavioral_change_analysis(\"TXN-DEMO-A101\")\n108:     assert \"behavioral_changes\" in res\n109:     assert len(res[\"behavioral_changes\"]) > 0\n110:     for change in res[\"behavioral_changes\"]:\n111:         assert \"neutral_assessment\" in change\n112: \n113: def test_real_time_prediction():\n114:     payload = TransactionPayload(\n115:         transaction_id=\"TXN-TEST-9999\",\n116:         account_id=\"ACC-TEST-1\",\n117:         amount=150.00,\n118:         currency=\"USD\",\n119:         merchant_category=\"grocery\",\n120:         device_id=\"DEV-TEST-1\",\n121:         ip_address=\"198.51.100.99\",\n122:         location_country=\"US\",\n123:         account_age_days=300,\n124:         failed_attempts_last_24h=0\n125:     )\n126:     res = predict_single_transaction(payload)\n127:     assert res.transaction_id == \"TXN-TEST-9999\"\n128:     assert 0.0 <= res.risk_score <= 100.0\n129:     assert res.triage_c