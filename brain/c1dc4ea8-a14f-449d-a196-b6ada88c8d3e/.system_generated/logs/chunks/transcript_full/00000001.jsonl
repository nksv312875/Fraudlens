{"step_index":17,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-29T14:07:20Z","content":"Created At: 2026-10-29T19:37:20+05:30\nCompleted At: 2026-10-29T19:37:21+05:30\nShowing lines 1-295 of 295\n1: \"\"\"\n2: FraudLens AI - Database Layer & Repository Pattern\n3: Supports SQLite out of the box with clean abstract repository interface\n4: ready to swap in PostgreSQL / SQLAlchemy for enterprise deployment.\n5: \"\"\"\n6: \n7: import sqlite3\n8: import json\n9: from datetime import datetime\n10: from typing import List, Dict, Any, Optional\n11: from pathlib import Path\n12: \n13: DB_FILE = Path(__file__).resolve().parents[3] / \"data\" / \"fraudlens.db\"\n14: \n15: class DatabaseManager:\n16:     def __init__(self, db_path: str = str(DB_FILE)):\n17:         self.db_path = db_path\n18:         self._init_db()\n19: \n20:     def get_connection(self) -> sqlite3.Connection:\n21:         conn = sqlite3.connect(self.db_path)\n22:         conn.row_factory = sqlite3.Row\n23:         return conn\n24: \n25:     def _init_db(self):\n26:         with self.get_connection() as conn:\n27:             cursor = conn.cursor()\n28:             # 1. Investigator Feedback & Audit History\n29:             cursor.execute(\"\"\"\n30:                 CREATE TABLE IF NOT EXISTS investigator_feedback (\n31:                     id INTEGER PRIMARY KEY AUTOINCREMENT,\n32:                     transaction_id TEXT NOT NULL,\n33:                     decision TEXT NOT NULL,\n34:                     reviewer_name TEXT NOT NULL,\n35:                     notes TEXT,\n36:                     model_version TEXT NOT NULL,\n37:                     original_model_score REAL,\n38:                     original_category TEXT,\n39:                     is_override INTEGER DEFAULT 0,\n40:                     created_at TEXT NOT NULL\n41:                 )\n42:             \"\"\")\n43: \n44:             # 2. Scored Transactions Store (Local Fast Query & Filter Cache)\n45:             cursor.execute(\"\"\"\n46:                 CREATE TABLE IF NOT EXISTS transactions (\n47:                     transaction_id TEXT PRIMARY KEY,\n48:                     timestamp TEXT NOT NULL,\n49:                     account_id TEXT NOT NULL,\n50:                     amount REAL NOT NULL,\n51:                     currency TEXT DEFAULT 'USD',\n52:                     merchant_id TEXT,\n53:                     merchant_category TEXT,\n54:                     device_id TEXT,\n55:                     ip_address TEXT,\n56:                     location_country TEXT,\n57:                     account_age_days INTEGER,\n58:                     failed_attempts_last_24h INTEGER,\n59:                     is_fraud_label INTEGER,\n60:                     risk_score REAL,\n61:                     calibrated_prob REAL,\n62:                     triage_category TEXT,\n63:                     uncertainty_indicator REAL,\n64:                     review_priority REAL,\n65:                     model_version TEXT,\n66:                     investigation_status TEXT DEFAULT 'pending_review',\n67:                     assigned_investigator TEXT DEFAULT 'Unassigned',\n68:                     feature_contributions_json TEXT,\n69:                     raw_features_json TEXT\n70:                 )\n71:             \"\"\")\n72: \n73:             # 3. System Audit Log\n74:             cursor.execute(\"\"\"\n75:                 CREATE TABLE IF NOT EXISTS audit_log (\n76:                     id INTEGER PRIMARY KEY AUTOINCREMENT,\n77:                     event_type TEXT NOT NULL,\n78:                     details_json TEXT NOT NULL,\n79:                     timestamp TEXT NOT NULL\n80:                 )\n81:             \"\"\")\n82:             conn.commit()\n83: \n84: class FeedbackRepository:\n85:     def __init__(self, db_manager: DatabaseManager):\n86:         self.db = db_manager\n87: \n88:     def record_feedback(\n89:         self,\n90:         transaction_id: str,\n91:         decision: str,\n92:         reviewer_name: str,\n93:         notes: Optional[str],\n94:         model_version: str,\n95:         original_model_score: Optional[float],\n96:         original_category: Optional[str]\n97:     ) -> Dict[str, Any]:\n98:         # Validate decision value\n99:         valid_decisions = [\"confirmed_fraud\", \"legitimate\", \"inconclusive\", \"escalated\"]\n100:         if decision not in valid_decisions:\n101:             raise ValueError(f\"Invalid decision '{decision}'. Must be one of {valid_decisions}\")\n102: \n103:         # Check if this decision is an override\n104:         # e.g., Model said HIGH RISK, but investigator marked 'legitimate', or LOWER RISK marked 'confirmed_fraud'\n105:         is_override = 0\n106:         if original_category == \"HIGH RISK\" and decision == \"legitimate\":\n107:             is_override = 1\n108:         elif original_category == \"LOWER RISK\" and decision == \"confirmed_fraud\":\n109:             is_override = 1\n110: \n111:         now = datetime.utcnow().isoformat()\n112: \n113:         with self.db.get_connection() as conn:\n114:             cursor = conn.cursor()\n115:             cursor.execute(\"\"\"\n116:                 INSERT INTO investigator_feedback (\n117:                     transaction_id, decision, reviewer_name, notes,\n118:                     model_version, original_model_score, original_category,\n119:                     is_override, created_at\n120:                 ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\n121:             \"\"\", (\n122:                 transaction_id, decision, reviewer_name, notes or \"\",\n123:                 model_version, original_model_score, original_category,\n124:                 is_override, now\n125:             ))\n126: \n127:             # Update status in transactions table\n128:             cursor.execute(\"\"\"\n129:                 UPDATE transactions\n130:                 SET investigation_status = ?, assigned_investigator = ?\n131:                 WHERE transaction_id = ?\n132:             \"\"\", (decision, reviewer_name, transaction_id))\n133: \n134:             # Add to audit log\n135:             audit_entry = {\n136:                 \"transaction_id\": transaction_id,\n137:                 \"action\": \"INVESTIGATOR_DECISION_RECORDED\",\n138:                 \"decision\": decision,\n139:                 \"reviewer\": reviewer_name,\n140:                 \"is_override\": bool(is_override)\n141:             }\n142:             cursor.execute(\"\"\"\n143:                 INSERT INTO audit_log (event_type, details_json, timestamp)\n144:                 VALUES (?, ?, ?)\n145:             \"\"\", (\"FEEDBACK_SUBMITTED\", json.dumps(audit_entry), now))\n146: \n147:             conn.commit()\n148:             record_id = cursor.lastrowid\n149: \n150:         return {\n151:             \"id\": record_id,\n152:             \"transaction_id\": transaction_id,\n153:             \"decision\": decision,\n154:             \"reviewer_name\": reviewer_name,\n155:             \"notes\": notes,\n156:             \"is_override\": bool(is_override),\n157:             \"created_at\": now\n158:         }\n159: \n160:     def list_feedback(self, limit: int = 100) -> List[Dict[str, Any]]:\n161:         with self.db.get_connection() as conn:\n162:             cursor = conn.cursor()\n163:             cursor.execute(\"\"\"\n164:                 SELECT * FROM investigator_feedback\n165:                 ORDER BY created_at DESC\n166:                 LIMIT ?\n167:             \"\"\", (limit,))\n168:             rows = cursor.fetchall()\n169:             return [dict(row) for row in rows]\n170: \n171: class TransactionRepository:\n172:     def __init__(self, db_manager: DatabaseManager):\n173:         self.db = db_manager\n174: \n175:     def save_scored_transactions_batch(self, transactions: List[Dict[str, Any]]):\n176:         with self.db.get_connection() as conn:\n177:             cursor = conn.cursor()\n178:             for t in transactions:\n179:                 cursor.execute(\"\"\"\n180:                     INSERT OR REPLACE INTO transactions (\n181:                         transaction_id, timestamp, account_id, amount, currency,\n182:                         merchant_id, merchant_category, device_id, ip_address,\n183:                         location_country, account_age_days, failed_attempts_last_24h,\n184:                         is_fraud_label, risk_score, calibrated_prob, triage_category,\n185:                         uncertainty_indicator, review_priority, model_version,\n186:                         investigation_status, assigned_investigator,\n187:                         feature_contributions_json, raw_features_json\n188:                     ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n189:                 \"\"\", (\n190:                     t[\"transaction_id\"], t[\"timestamp\"], t[\"account_id\"], t[\"amount\"], t.get(\"currency\", \"USD\"),\n191:                     t.get(\"merchant_id\"), t.get(\"merchant_category\"), t.get(\"device_id\"), t.get(\"ip_address\"),\n192:                     t.get(\"location_country\"), t.get(\"account_age_days\"), t.get(\"failed_attempts_last_24h\"),\n193:                     t.get(\"is_fraud\"), t.get(\"risk_score\"), t.get(\"calibrated_prob\"), t.get(\"triage_category\"),\n194:                     t.get(\"uncertainty_indicator\"), t.get(\"review_priority\"), t.get(\"model_version\"),\n195:                     t.get(\"investigation_status\", \"pending_review\"), t.get(\"assigned_investigator\", \"Unassigned\"),\n196:                     json.dumps(t.get(\"feature_contributions\", [])),\n197:                     json.dumps(t.get(\"raw_features\", {}))\n198:                 ))\n199:             conn.commit()\n200: \n201:     def get_transaction_by_id(self, txn_id: str) -> Optional[Dict[str, Any]]:\n202:         with self.db.get_connection() as conn:\n203:             cursor = conn.cursor()\n204:             cursor.execute(\"SELECT * FROM transactions WHERE transaction_id = ?\", (txn_id,))\n205:             row = cursor.fetchone()\n206:             if not row:\n207:                 return None\n208:             res = dict(row)\n209:             if res.get(\"feature_contributions_json\"):\n210:                 res[\"feature_contributions\"] = json.loads(res[\"feature_contributions_json\"])\n211:             if res.get(\"raw_features_json\"):\n212:                 res[\"raw_features\"] = json.loads(res[\"raw_features_json\"])\n213:             return res\n214: \n215:     def query_queue(\n216:         self,\n217:         triage_category: Optional[str] = None,\n218:         min_risk: Optional[float] = None,\n219:         status: Optional[str] = None,\n220:         sort_by: str = \"review_priority\",\n221:         ascending: bool = False,\n222:         limit: int = 150\n223:     ) -> List[Dict[str, Any]]:\n224:         query = \"SELECT * FROM transactions WHERE 1=1\"\n225:         params = []\n226: \n227:         if triage_category and triage_category != \"ALL\":\n228:             query += \" AND triage_category = ?\"\n229:             params.append(triage_category)\n230:         if min_risk is not None:\n231:             query += \" AND risk_score >= ?\"\n232:             params.append(min_risk)\n233:         if status and status != \"ALL\":\n234:             query += \" AND investigation_status = ?\"\n235:             params.append(status)\n236: \n237:         # Allowable sort columns\n238:         allowed_sorts = [\"review_priority\", \"risk_score\", \"uncertainty_indicator\", \"amount\", \"timestamp\"]\n239:         sort_col = sort_by if sort_by in allowed_sorts else \"review_priority\"\n240:         order = \"ASC\" if ascending else \"DESC\"\n241:         query += f\" ORDER BY {sort_col} {order} LIMIT ?\"\n242:         params.append(limit)\n243: \n244:         with self.db.get_connection() as conn:\n245:             cursor = conn.cursor()\n246:             cursor.execute(query, tuple(params))\n247:             rows = cursor.fetchall()\n248:             results = []\n249:             for r in rows:\n250:                 item = dict(r)\n251:                 if item.get(\"feature_contributions_json\"):\n252:                     item[\"feature_contributions\"] = json.loads(item[\"feature_contributions_json\"])\n253:                 results.append(item)\n254:             return results\n255: \n256:     def get_timeline_for_account(self, account_id: str) -> List[Dict[str, Any]]:\n257:         with self.db.get_connection() as conn:\n258:             cursor = conn.cursor()\n259:             cursor.execute(\"\"\"\n260:                 SELECT * FROM transactions\n261:                 WHERE account_id = ?\n262:                 ORDER BY timestamp ASC\n263:             \"\"\", (account_id,))\n264:             rows = cursor.fetchall()\n265:             return [dict(r) for r in rows]\n266: \n267:     def count_summary(self) -> Dict[str, Any]:\n268:         with self.db.get_connection() as conn:\n269:             cursor = conn.cursor()\n270:             cursor.execute(\"SELECT COUNT(*) FROM transactions\")\n271:             total = cursor.fetchone()[0]\n272: \n273:             cursor.execute(\"SELECT COUNT(*) FROM transactions WHERE triage_category = 'HIGH RISK'\")\n274:             high_risk = cursor.fetchone()[0]\n275: \n276:             cursor.execute(\"SELECT COUNT(*) FROM transactions WHERE triage_category = 'UNCERTAIN'\")\n277:             uncertain = cursor.fetchone()[0]\n278: \n279:             cursor.execute(\"SELECT COUNT(*) FROM transactions WHERE triage_category = 'LOWER RISK'\")\n280:             lower_risk = cursor.fetchone()[0]\n281: \n282:             cursor.execute(\"SELECT COUNT(*) FROM investigator_feedback WHERE decision = 'confirmed_fraud'\")\n283:             confirmed_fraud = cursor.fetchone()[0]\n284: \n285:             cursor.execute(\"SELECT COUNT(*) FROM investigator_feedback WHERE is_override = 1\")\n286:             overrides = cursor.fetchone()[0]\n287: \n288:             return {\n289:                 \"total_analyzed\": total,\n290:                 \"high_risk_cases\": high_risk,\n291:                 \"uncertain_cases\": uncertain,\n292:                 \"lower_risk_cases\": lower_risk,\n293:                 \"confirmed_fraud_feedback\": confirmed_fraud,\n294:                 \"investigator_overrides\": overrides\n295:             }"}
{"step_index":18,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-29T14:07:20Z","content":"Created At: 2026-10-29T19:37:20+05:30\nCompleted At: 2026-10-29T19:37:21+05:30\nShowing lines 1-85 of 85\n1: \"\"\"\n2: FraudLens AI - Database & Model Initializer\n3: Pre-populates SQLite with scored transactions, initial investigator decisions,\n4: and pre-computes graph relations.\n5: \"\"\"\n6: \n7: import json\n8: import joblib\n9: import pandas as pd\n10: from pathlib import Path\n11: from app.db.repository import DatabaseManager, TransactionRepository, FeedbackRepository\n12: from app.ml.features import FeatureExtractor\n13: \n14: PROJECT_ROOT = Path(__file__).resolve().parents[3]\n15: DATA_CSV = PROJECT_ROOT / \"data\" / \"synthetic_transactions.csv\"\n16: MODEL_PATH = PROJECT_ROOT / \"model_store\" / \"fraudlens_predictor.joblib\"\n17: \n18: def initialize_and_seed_data():\n19:     print(\"[1/4] Connecting to SQLite database...\")\n20:     db_mgr = DatabaseManager()\n21:     txn_repo = TransactionRepository(db_mgr)\n22:     feedback_repo = FeedbackRepository(db_mgr)\n23: \n24:     print(\"[2/4] Loading trained predictor and dataset...\")\n25:     predictor = joblib.load(MODEL_PATH)\n26:     df = pd.read_csv(DATA_CSV)\n27:     df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"])\n28:     df = df.sort_values(\"timestamp\").reset_index(drop=True)\n29: \n30:     extractor = FeatureExtractor()\n31:     feat_df = extractor.fit_transform_dataframe(df)\n32: \n33:     print(f\"[3/4] Scoring {len(df)} transactions through ML pipeline...\")\n34:     scored_records = []\n35:     for i, row in df.iterrows():\n36:         raw_dict = row.to_dict()\n37:         raw_dict[\"timestamp\"] = str(row[\"timestamp\"])\n38:         feat_dict = feat_df.iloc[i].to_dict()\n39: \n40:         pred_res = predictor.predict_transaction(feat_dict)\n41: \n42:         record = {\n43:             **raw_dict,\n44:             \"risk_score\": pred_res[\"risk_score\"],\n45:             \"calibrated_prob\": pred_res[\"calibrated_probability\"],\n46:             \"triage_category\": pred_res[\"triage_category\"],\n47:             \"uncertainty_indicator\": pred_res[\"uncertainty_indicator\"],\n48:             \"review_priority\": pred_res[\"review_priority\"],\n49:             \"model_version\": pred_res[\"model_version\"],\n50:             \"investigation_status\": \"pending_review\",\n51:             \"assigned_investigator\": \"Unassigned\",\n52:             \"feature_contributions\": pred_res[\"feature_contributions\"],\n53:             \"raw_features\": feat_dict\n54:         }\n55:         scored_records.append(record)\n56: \n57:     txn_repo.save_scored_transactions_batch(scored_records)\n58:     print(f\"      Persisted {len(scored_records)} scored transactions to SQLite.\")\n59: \n60:     # Seed 3 initial investigator decisions to demonstrate audit history\n61:     print(\"[4/4] Seeding initial investigator review audit trail...\")\n62:     feedback_repo.record_feedback(\n63:         transaction_id=\"TXN-DEMO-B202\",\n64:         decision=\"confirmed_fraud\",\n65:         reviewer_name=\"Agent Sarah Chen (Lead Investigator)\",\n66:         notes=\"Multiple red flags confirmed: new untrusted device, foreign IP from Lagos, and previous 4 failed password attempts. Account frozen.\",\n67:         model_version=predictor.meta.get(\"version\", \"v1.2.0\"),\n68:         original_model_score=94.2,\n69:         original_category=\"HIGH RISK\"\n70:     )\n71: \n72:     feedback_repo.record_feedback(\n73:         transaction_id=\"TXN-DEMO-A101\",\n74:         decision=\"legitimate\",\n75:         reviewer_name=\"Agent Marcus Vance (Senior Analyst)\",\n76:         notes=\"Customer verified via SMS step-up authentication. Known trusted device and resident IP address. Approved legitimate luxury purchase.\",\n77:         model_version=predictor.meta.get(\"version\", \"v1.2.0\"),\n78:         original_model_score=28.5,\n79:         original_category=\"LOWER RISK\"\n80:     )\n81: \n82:     print(\"Database seeding completed successfully.\")\n83: \n84: if __name__ == \"__main__\":\n85:     initialize_and_seed_data()"}
{"step_index":19,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-29T14:07:21Z","content":"Created At: 2026-10-29T19:37:21+05:30\nCompleted At: 2026-10-29T19:37:21+05:30\nShowing lines 1-197 of 197\n1: \"\"\"\n2: FraudLens AI - NetworkX Graph Relationship & Entity Clustering Engine\n3: Constructs multi-entity risk graphs connecting:\n4: - Transactions\n5: - User Accounts\n6: - Devices\n7: - IP Addresses\n8: - Merchants\n9: \n10: Performs:\n11: - Bipartite entity projection (Account-Device-Account)\n12: - Connected components (fraud ring / syndicate detection)\n13: - Neighborhood ego-graph extraction for individual transactions\n14: - Edge justification (documenting why each relationship exists)\n15: \"\"\"\n16: \n17: from typing import Dict, List, Any, Optional\n18: import networkx as nx\n19: import pandas as pd\n20: \n21: class FraudGraphEngine:\n22:     def __init__(self):\n23:         self.graph = nx.Graph()\n24:         self.transaction_map = {}\n25: \n26:     def build_graph_from_dataframe(self, df: pd.DataFrame):\n27:         \"\"\"\n28:         Builds the global multi-entity graph from transaction records.\n29:         \"\"\"\n30:         self.graph.clear()\n31:         self.transaction_map.clear()\n32: \n33:         for _, row in df.iterrows():\n34:             txn_id = str(row[\"transaction_id\"])\n35:             account_id = str(row[\"account_id\"])\n36:             device_id = str(row.get(\"device_id\", \"DEV-UNKNOWN\"))\n37:             ip_addr = str(row.get(\"ip_address\", \"0.0.0.0\"))\n38:             merchant_id = str(row.get(\"merchant_id\", \"MER-UNKNOWN\"))\n39:             amount = float(row.get(\"amount\", 0.0))\n40:             is_fraud = int(row.get(\"is_fraud\", 0))\n41:             cat = str(row.get(\"merchant_category\", \"general\"))\n42:             timestamp = str(row.get(\"timestamp\", \"\"))\n43: \n44:             self.transaction_map[txn_id] = row.to_dict()\n45: \n46:             # 1. Add Transaction Node\n47:             self.graph.add_node(\n48:                 txn_id,\n49:                 node_type=\"transaction\",\n50:                 label=f\"Txn {txn_id[-8:]}\",\n51:                 amount=amount,\n52:                 is_fraud=is_fraud,\n53:                 timestamp=timestamp\n54:             )\n55: \n56:             # 2. Add Account Node\n57:             if not self.graph.has_node(account_id):\n58:                 self.graph.add_node(\n59:                     account_id,\n60:                     node_type=\"account\",\n61:                     label=f\"Acc {account_id[-6:]}\",\n62:                     tx_count=0,\n63:                     total_volume=0.0\n64:                 )\n65:             self.graph.nodes[account_id][\"tx_count\"] += 1\n66:             self.graph.nodes[account_id][\"total_volume\"] += amount\n67: \n68:             # 3. Add Device Node\n69:             if not self.graph.has_node(device_id):\n70:                 self.graph.add_node(\n71:                     device_id,\n72:                     node_type=\"device\",\n73:                     label=f\"Dev {device_id[-6:]}\",\n74:                     accounts=set()\n75:                 )\n76:             self.graph.nodes[device_id][\"accounts\"].add(account_id)\n77: \n78:             # 4. Add IP Node\n79:             if not self.graph.has_node(ip_addr):\n80:                 self.graph.add_node(\n81:                     ip_addr,\n82:                     node_type=\"ip\",\n83:                     label=f\"IP {ip_addr}\",\n84:                     accounts=set()\n85:                 )\n86:             self.graph.nodes[ip_addr][\"accounts\"].add(account_id)\n87: \n88:             # 5. Add Merchant Node\n89:             if not self.graph.has_node(merchant_id):\n90:                 self.graph.add_node(\n91:                     merchant_id,\n92:                     node_type=\"merchant\",\n93:                     label=f\"Mer {merchant_id[-6:]}\",\n94:                     category=cat\n95:                 )\n96: \n97:             # Connect Edges with Evidence Justification\n98:             self.graph.add_edge(\n99:                 txn_id, account_id,\n100:                 relation=\"ORIGINATED_FROM\",\n101:                 evidence=\"Primary account holder initiated payment instruction.\"\n102:             )\n103:             self.graph.add_edge(\n104:                 txn_id, device_id,\n105:                 relation=\"CAPTURED_DEVICE\",\n106:                 evidence=\"Device browser/hardware fingerprint captured at checkout.\"\n107:             )\n108:             self.graph.add_edge(\n109:                 txn_id, ip_addr,\n110:                 relation=\"ROUTED_THROUGH_IP\",\n111:                 evidence=\"HTTP TCP/IP network connection packet header.\"\n112:             )\n113:             self.graph.add_edge(\n114:                 txn_id, merchant_id,\n115:                 relation=\"SETTLED_AT\",\n116:                 evidence=\"Acquiring merchant terminal ID.\"\n117:             )\n118: \n119:     def get_ego_graph(self, txn_id: str, depth: int = 2) -> Dict[str, Any]:\n120:         \"\"\"\n121:         Extracts the localized subnetwork around a specific transaction,\n122:         revealing shared devices, shared IPs, and correlated accounts.\n123:         \"\"\"\n124:         if txn_id not in self.graph:\n125:             return {\"nodes\": [], \"edges\": [], \"syndicate_cluster_size\": 0, \"shared_devices\": [], \"shared_ips\": []}\n126: \n127:         # Ego network up to specified radius\n128:         ego_nodes = nx.single_source_shortest_path_length(self.graph, txn_id, cutoff=depth)\n129:         subgraph = self.graph.subgraph(ego_nodes.keys())\n130: \n131:         nodes_out = []\n132:         for node_id in subgraph.nodes():\n133:             nd = dict(subgraph.nodes[node_id])\n134:             # Serialize sets\n135:             if \"accounts\" in nd:\n136:                 nd[\"account_count\"] = len(nd[\"accounts\"])\n137:                 nd[\"accounts\"] = list(nd[\"accounts\"])\n138:             nodes_out.append({\n139:                 \"id\": str(node_id),\n140:                 **nd\n141:             })\n142: \n143:         edges_out = []\n144:         for u, v, data in subgraph.edges(data=True):\n145:             edges_out.append({\n146:                 \"source\": str(u),\n147:                 \"target\": str(v),\n148:                 \"relation\": data.get(\"relation\", \"CONNECTED\"),\n149:                 \"evidence\": data.get(\"evidence\", \"Observed network link\")\n150:             })\n151: \n152:         # Identify shared entities in ego subgraph\n153:         shared_devices = [\n154:             n[\"id\"] for n in nodes_out\n155:             if n.get(\"node_type\") == \"device\" and n.get(\"account_count\", 0) > 1\n156:         ]\n157:         shared_ips = [\n158:             n[\"id\"] for n in nodes_out\n159:             if n.get(\"node_type\") == \"ip\" and n.get(\"account_count\", 0) > 1\n160:         ]\n161: \n162:         return {\n163:             \"root_transaction\": txn_id,\n164:             \"nodes\": nodes_out,\n165:             \"edges\": edges_out,\n166:             \"cluster_node_count\": len(nodes_out),\n167:             \"shared_devices\": shared_devices,\n168:             \"shared_ips\": shared_ips,\n169:             \"has_syndicate_overlap\": (len(shared_devices) > 0 or len(shared_ips) > 0)\n170:         }\n171: \n172:     def detect_syndicate_clusters(self, min_shared_accounts: int = 2) -> List[Dict[str, Any]]:\n173:         \"\"\"\n174:         Scans global graph for potential fraud syndicates:\n175:         Clusters where 2 or more distinct accounts share the same physical device or IP.\n176:         \"\"\"\n177:         syndicates = []\n178:         for dev_id, data in self.graph.nodes(data=True):\n179:             if data.get(\"node_type\") == \"device\":\n180:                 accounts = list(data.get(\"accounts\", set()))\n181:                 if len(accounts) >= min_shared_accounts:\n182:                     # Gather related transactions\n183:                     connected_txns = [\n184:                         neighbor for neighbor in self.graph.neighbors(dev_id)\n185:                         if self.graph.nodes[neighbor].get(\"node_type\") == \"transaction\"\n186:                     ]\n187:                     syndicates.append({\n188:                         \"entity_type\": \"device\",\n189:                         \"entity_id\": dev_id,\n190:                         \"shared_account_count\": len(accounts),\n191:                         \"accounts\": accounts,\n192:                         \"associated_transactions\": connected_txns,\n193:                         \"risk_level\": \"CRITICAL\" if len(accounts) >= 3 else \"HIGH\",\n194:                         \"narrative\": f\"Device {dev_id} shared across {len(accounts)} accounts ({', '.join(accounts[:3])}).\"\n195:                     })\n196: \n197:         return syndicates"}
