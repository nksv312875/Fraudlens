 }, []);\n40: \n41:   const handleSelectTransaction = (id: string) => {\n42:     setSelectedTxnId(id);\n43:     setActiveTab('detail');\n44:   };\n45: \n46:   const handleNavigateToReplay = (id: string) => {\n47:     setSelectedTxnId(id);\n48:     setActiveTab('replay');\n49:   };\n50: \n51:   const handleNavigateToRadar = (id: string) => {\n52:     setSelectedTxnId(id);\n53:     setActiveTab('radar');\n54:   };\n55: \n56:   const handleNavigateToQueue = (category?: string) => {\n57:     if (category) {\n58:       setQueueCategoryFilter(category);\n59:     }\n60:     setActiveTab('queue');\n61:   };\n62: \n63:   const handleSelectDemoCase = (caseKey: 'case_a' | 'case_b' | 'case_c') => {\n64:     if (caseKey === 'case_a') {\n65:       setSelectedTxnId('TXN-DEMO-A101');\n66:       setActiveTab('detail');\n67:     } else if (caseKey === 'case_b') {\n68:       setSelectedTxnId('TXN-DEMO-B202');\n69:       setActiveTab('replay');\n70:     } else if (caseKey === 'case_c') {\n71:       setSelectedTxnId('TXN-DEMO-C301');\n72:       setActiveTab('radar');\n73:     }\n74:   };\n75: \n76:   const handleResetDemo = async () => {\n77:     await api.resetDemoData();\n78:     await loadStats();\n79:     setSelectedTxnId('TXN-DEMO-B202');\n80:     setActiveTab('overview');\n81:   };\n82: \n83:   return (\n84:     <div className=\"min-h-screen bg-navy-900 text-slate-100 flex flex-col font-['Plus_Jakarta_Sans',sans-serif]\">\n85:       {/* Top Application Navbar */}\n86:       <Navbar\n87:         activeModelVersion={stats?.model_metadata?.version || 'v1.2.0-champion'}\n88:         onResetDemo={handleResetDemo}\n89:         onSelectDemoCase={handleSelectDemoCase}\n90:         onToggleSimulation={() => setIsSimulating(!isSimulating)}\n91:         isSimulating={isSimulating}\n92:       />\n93: \n94:       {/* Main Workspace Layout */}\n95:       <div className=\"flex flex-1 overflow-hidden\">\n96:         {/* Navigation Sidebar */}\n97:         <Sidebar\n98:           activeTab={activeTab}\n99:           onTabChange={setActiveTab}\n100:           highRiskCount={stats?.summary?.high_risk_cases || 0}\n101:           uncertainCount={stats?.summary?.uncertain_cases || 0}\n102:         />\n103: \n104:         {/* Content Viewport */}\n105:         <main className=\"flex-1 overflow-y-auto p-6 bg-navy-900\">\n106:           <div className=\"max-w-7xl mx-auto\">\n107:             {activeTab === 'overview' && (\n108:               <OverviewDashboard\n109:                 stats={stats}\n110:                 loading={loadingStats}\n111:                 onNavigateToQueue={handleNavigateToQueue}\n112:                 onSelectTransaction={handleSelectTransaction}\n113:                 onSelectDemoCase={handleSelectDemoCase}\n114:               />\n115:             )}\n116: \n117:             {activeTab === 'queue' && (\n118:               <InvestigationQueue\n119:                 initialCategory={queueCategoryFilter}\n120:                 onSelectTransaction={handleSelectTransaction}\n121:               />\n122:             )}\n123: \n124:             {activeTab === 'detail' && (\n125:               <TransactionDetail\n126:                 transactionId={selectedTxnId}\n127:                 onNavigateToReplay={handleNavigateToReplay}\n128:                 onNavigateToRadar={handleNavigateToRadar}\n129:                 onDecisionSubmitted={loadStats}\n130:               />\n131:             )}\n132: \n133:             {activeTab === 'replay' && (\n134:               <ReplayLab\n135:                 transactionId={selectedTxnId}\n136:                 onSelectTransaction={setSelectedTxnId}\n137:               />\n138:             )}\n139: \n140:             {activeTab === 'radar' && (\n141:               <FraudNetworkRadar\n142:                 transactionId={selectedTxnId}\n143:                 onSelectTransaction={handleSelectTransaction}\n144:               />\n145:             )}\n146: \n147:             {activeTab === 'evaluation' && (\n148:               <ModelEvaluation stats={stats} />\n149:             )}\n150: \n151:             {activeTab === 'feedback' && (\n152:               <FeedbackHistory onSelectTransaction={handleSelectTransaction} />\n153:             )}\n154: \n155:             {activeTab === 'upload' && (\n156:               <CsvUpload onBatchScored={loadStats} />\n157:             )}\n158: \n159:             {activeTab === 'model_info' && (\n160:               <ModelInfo stats={stats} />\n161:             )}\n162:           </div>\n163:         </main>\n164:       </div>\n165: \n166:       {/* Real-time Streaming Simulation Modal */}\n167:       <LiveSimulationModal\n168:         isOpen={isSimulating}\n169:         onClose={() => setIsSimulating(false)}\n170:         onSelectTransaction={handleSelectTransaction}\n171:       />\n172:     </div>\n173:   );\n174: }\n175: \n176: export default App;"}
