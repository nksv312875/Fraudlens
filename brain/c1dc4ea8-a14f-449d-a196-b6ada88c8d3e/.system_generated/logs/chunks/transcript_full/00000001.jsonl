empts,\n143:             \"is_foreign_country\": is_foreign,\n144:             \"merchant_category_risk\": merchant_risk,\n145:             \"device_reuse_count\": device_reuse_count,\n146:             \"is_device_new_to_account\": is_device_new,\n147:             \"tx_frequency_1h\": tx_freq_1h,\n148:             \"burst_amount_1h\": burst_amt_1h\n149:         }\n150: \n151:         # Update historical state if requested\n152:         if update_state:\n153:             if account_id not in self.account_history:\n154:                 self.account_history[account_id] = []\n155:             self.account_history[account_id].append({\n156:                 \"amount\": amount,\n157:                 \"device_id\": device_id,\n158:                 \"ip_address\": ip_address,\n159:                 \"dt\": curr_dt\n160:             })\n161: \n162:             if device_id not in self.device_accounts:\n163:                 self.device_accounts[device_id] = set()\n164:             self.device_accounts[device_id].add(account_id)\n165: \n166:             if ip_address not in self.ip_accounts:\n167:                 self.ip_accounts[ip_address] = set()\n168:             self.ip_accounts[ip_address].add(account_id)\n169: \n170:         return features"}
