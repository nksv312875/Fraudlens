     </h1>\n51:           <p className=\"text-xs text-slate-400 mt-1\">\n52:             Real-time portfolio surveillance, calibrated decision boundaries, and evidence-grounded risk metrics.\n53:           </p>\n54:         </div>\n55:         <div className=\"flex items-center gap-2\">\n56:           <span className=\"px-3 py-1 rounded-md bg-slate-800 border border-slate-700 text-xs font-mono text-slate-300 flex items-center gap-1.5\">\n57:             <Cpu className=\"w-3.5 h-3.5 text-teal-400\" />\n58:             Model: {model_metadata.version} ({champion.algorithm})\n59:           </span>\n60:         </div>\n61:       </div>\n62: \n63:       {/* KPI Highlight Cards */}\n64:       <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n65:         {/* Total Analyzed */}\n66:         <div className=\"bg-slate-850 border border-slate-700/80 rounded-xl p-4 shadow-sm relative overflow-hidden\">\n67:           <div className=\"flex items-center justify-between text-slate-400 text-xs font-medium mb-2\">\n68:             <span>TRANSACTIONS ANALYZED</span>\n69:             <Activity className=\"w-4 h-4 text-cyan-400\" />\n70:           </div>\n71:           <div className=\"text-2xl font-bold font-mono text-slate-100\">\n72:             {summary.total_analyzed.toLocaleString()}\n73:           </div>\n74:           <div className=\"mt-2 text-[11px] text-slate-400 flex items-center gap-1\">\n75:             <span className=\"text-teal-400 font-semibold\">100% genuine</span> ML pipeline inference\n76:           </div>\n77:         </div>\n78: \n79:         {/* High Risk Cases */}\n80:         <div\n81:           onClick={() => onNavigateToQueue('HIGH RISK')}\n82:           className=\"bg-slate-850 border border-rose-900/40 hover:border-rose-700/80 rounded-xl p-4 shadow-sm cursor-pointer transition group\"\n83:         >\n84:           <div className=\"flex items-center justify-between text-rose-300 text-xs font-medium mb-2\">\n85:             <span>HIGH RISK ALERTS</span>\n86:             <ShieldAlert className=\"w-4 h-4 text-rose-400 group-hover:scale-110 transition\" />\n87:           </div>\n88:           <div className=\"text-2xl font-bold font-mono text-rose-400\">\n89:             {summary.high_risk_cases.toLocaleString()}\n90:           </div>\n91:           <div className=\"mt-2 text-[11px] text-slate-400 flex items-center justify-between\">\n92:             <span>Requires operational review</span>\n93:             <ArrowRight className=\"w-3.5 h-3.5 text-rose-400 group-hover:translate-x-1 transition\" />\n94:           </div>\n95:         </div>\n96: \n97:         {/* Uncertain Cases */}\n98:         <div\n99:           onClick={() => onNavigateToQueue('UNCERTAIN')}\n100:           className=\"bg-slate-850 border border-amber-900/40 hover:border-amber-700/80 rounded-xl p-4 shadow-sm cursor-pointer transition group\"\n101:         >\n102:           <div className=\"flex items-center justify-between text-amber-300 text-xs font-medium mb-2\">\n103:             <span>UNCERTAIN CASES</span>\n104:             <HelpCircle className=\"w-4 h-4 text-amber-400 group-hover:scale-110 transition\" />\n105:           </div>\n106:           <div className=\"text-2xl font-bold font-mono text-amber-400\">\n107:             {summary.uncertain_cases.toLocaleString()}\n108:           </div>\n109:           <div className=\"mt-2 text-[11px] text-slate-400 flex items-center justify-between\">\n110:             <span>Ambiguous / boundary signals</span>\n111:             <ArrowRight className=\"w-3.5 h-3.5 text-amber-400 group-hover:translate-x-1 transition\" />\n112:           </div>\n113:         </div>\n114: \n115:         {/* Confirmed Fraud from Reviewers */}\n116:         <div className=\"bg-slate-850 border border-slate-700/80 rounded-xl p-4 shadow-sm\">\n117:           <div className=\"flex items-center justify-between text-slate-400 text-xs font-medium mb-2\">\n118:             <span>CONFIRMED FRAUD AUDIT</span>\n119:             <CheckCircle className=\"w-4 h-4 text-teal-400\" />\n120:           </div>\n121:           <div className=\"text-2xl font-bold font-mono text-teal-400\">\n122:             {summary.confirmed_fraud_feedback.toLocaleString()}\n123:           </div>\n124:           <div className=\"mt-2 text-[11px] text-slate-400\">\n125:             {summary.investigator_overrides} reviewer overrides recorded\n126:           </div>\n127:         </div>\n128:       </div>\n129: \n130:       {/* Tri-Pane Intelligence Grid */}\n131:       <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n132:         {/* Risk Distribution Breakdown */}\n133:         <div className=\"bg-slate-850 border border-slate-700/80 rounded-xl p-5 space-y-4\">\n134:           <div className=\"flex items-center justify-between\">\n135:             <h2 className=\"text-sm font-bold text-slate-200 flex items-center gap-2\">\n136:               <Layers className=\"w-4 h-4 text-cyan-400\" />\n137:               Three-Outcome Risk Distribution\n138:             </h2>\n139:             <span className=\"text-[11px] font-mono text-slate-400\">Current Portfolio</span>\n140:           </div>\n141: \n142:           <div className=\"space-y-3\">\n143:             {risk_distribution.map((dist) => (\n144:               <div key={dist.category} className=\"space-y-1.5\">\n145:                 <div className=\"flex justify-between text-xs font-medium\">\n146:                   <span className=\"text-slate-300 flex items-center gap-1.5\">\n147:                     <span className=\"w-2.5 h-2.5 rounded-full\" style={{ backgroundColor: dist.color }} />\n148:                     {dist.category}\n149:                   </span>\n150:                   <span className=\"font-mono text-slate-300\">\n151:                     {dist.count.toLocaleString()} ({dist.percentage}%)\n152:                   </span>\n153:                 </div>\n154:                 <div className=\"w-full h-2 bg-slate-900 rounded-full overflow-hidden\">\n155:                   <div\n156:                     className=\"h-full rounded-full transition-all duration-500\"\n157:                     style={{ width: `${dist.percentage}%`, backgroundColor: dist.color }}\n158:                   />\n159:                 </div>\n160:               </div>\n161:             ))}\n162:           </div>\n163: \n164:           <div className=\"p-3 bg-slate-900 rounded-lg border border-slate-800 text-[11px] text-slate-400 space-y-1\">\n165:             <p className=\"font-medium text-slate-300\">Operational Triage Policy:</p>\n166:             <p>• High Risk (&gt;= {stats.thresholds.tau_high * 100}%): Direct investigation queue.</p>\n167:             <p>• Uncertain ({stats.thresholds.tau_low * 100}% - {stats.thresholds.tau_high * 100}% or high ambiguity): Secondary check.</p>\n168:             <p>• Lower Risk (&lt; {stats.thresholds.tau_low * 100}%): Continuous baseline surveillance.</p>\n169:           </div>\n170:         </div>\n171: \n172:         {/* Top Evidence-Based Alert Reasons */}\n173:         <div className=\"bg-slate-850 border border-slate-700/80 rounded-xl p-5 space-y-4\">\n174:           <div className=\"flex items-center justify-between\">\n175:             <h2 className=\"text-sm font-bold text-slate-200 flex items-center gap-2\">\n176:               <TrendingUp className=\"w-4 h-4 text-teal-400\" />\n177:               Top Evidence Contributions\n178:             </h2>\n179:             <span className=\"text-[11px] font-mono text-slate-400\">Reason Frequency</span>\n180:           </div>\n181: \n182:           <div className=\"space-y-2.5\">\n183:             {top_evidence_reasons.map((reason, idx) => (\n184:               <div\n185:                 key={reason.code}\n186:                 className=\"p-2.5 rounded-lg bg-slate-900/80 border border-slate-800 flex items-center justify-between text-xs\"\n187:               >\n188:                 <div className=\"flex items-center gap-2\">\n189:                   <span className=\"w-5 h-5 rounded bg-slate-800 text-cyan-400 font-mono text-[10px] flex items-center justify-center font-bold\">\n190:                     0{idx + 1}\n191:                   </span>\n192:                   <div>\n193:                     <span className=\"font-medium text-slate-200 block\">{reason.description}</span>\n194:                     <span className=\"font-mono text-[10px] text-slate-400\">{reason.code}</span>\n195:                   </div>\n196:                 </div>\n197:                 <span className=\"font-mono font-bold text-rose-400 bg-rose-950/60 px-2 py-0.5 rounded border border-rose-900/50\">\n198:                   {reason.count} alerts\n199:                 </span>\n200:               </div>\n201:             ))}\n202:           </div>\n203: \n204:           <p className=\"text-[11px] text-slate-400\">\n205:             Ground-truth derived reason codes mapped from actual feature attribution distributions.\n206:           </p>\n207:         </div>\n208: \n209:         {/* Held-out Model Performance Metrics */}\n210:         <div className=\"bg-slate-850 border border-slate-700/80 rounded-xl p-5 space-y-4\">\n211:           <div className=\"flex items-center justify-between\">\n212:             <h2 className=\"text-sm font-bold text-slate-200 flex items-center gap-2\">\n213:               <Cpu className=\"w-4 h-4 text-cyan-400\" />\n214:               Held-Out Test Set Metrics\n215:             </h2>\n216:             <span className=\"text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-teal-950 text-teal-300 border border-teal-800\">\n217:               Verified\n218:             </span>\n219:           </div>\n220: \n221:           <div className=\"grid grid-cols-2 gap-3\">\n222:             <div className=\"p-3 bg-slate-900 rounded-lg border border-slate-800\">\n223:               <span className=\"text-[11px] text-slate-400 block\">PRECISION</span>\n224:               <span className=\"text-xl font-bold font-mono text-slate-100\">\n225:                 {(champion.precision * 100).toFixed(1)}%\n226:               </span>\n227:               <span className=\"text-[10px] text-slate-400 block mt-0.5\">Minimal false alarms</span>\n228:             </div>\n229: \n230:             <div className=\"p-3 bg-slate-900 rounded-lg border border-slate-800\">\n231:               <span className=\"text-[11px] text-slate-400 block\">RECALL</span>\n232:               <span className=\"text-xl font-bold font-mono text-slate-100\">\n233:                 {(champion.recall * 100).toFixed(1)}%\n234:               </span>\n235:               <span className=\"text-[10px] text-slate-400 block mt-0.5\">Fraud capture rate</span>\n236:             </div>\n237: \n238:             <div className=\"p-3 bg-slate-900 rounded-lg border border-slate-800\">\n239:               <span className=\"text-[11px] text-slate-400 block\">F1 SCORE</span>\n240:               <span className=\"text-xl font-bold font-mono text-cyan-400\">\n241:                 {champion.f1_score.toFixed(3)}\n242:               </span>\n243:               <span className=\"text-[10px] text-slate-400 block mt-0.5\">Harmonic mean</span>\n244:             </div>\n245: \n246:             <div className=\"p-3 bg-slate-900 rounded-lg border border-slate-800\">\n247:               <span className=\"text-[11px] text-slate-400 block\">PRECISION @ CAP (TOP 20)</span>\n248:               <span className=\"text-xl font-bold font-mono text-teal-400\">\n249:                 {(champion.precision_at_capacity_top20 * 100).toFixed(1)}%\n250:               </span>\n251:               <span className=\"text-[10px] text-slate-400 block mt-0.5\">Review queue efficiency</span>\n252:             </div>\n253:           </div>\n254: \n255:           <p className=\"text-[10px] text-slate-400\">\n256:             *Evaluated on {evaluation_metrics.held_out_test_records} held-out chronological test records (zero lookahead leakage).\n257:           </p>\n258:         </div>\n259:       </div>\n260: \n261:       {/* 3-Minute Reproducible Demo Scenarios Card */}\n262:       <div className=\"bg-gradient-to-r from-navy-800 via-slate-850 to-navy-850 border border-cyan-500/30 rounded-xl p-5 shadow-lg\">\n263:         <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-4\">\n264:           <div>\n265:             <div className=\"flex items-center gap-2\">\n266:               <Sparkles className=\"w-5 h-5 text-cyan-400\" />\n267:               <h2 className=\"text-base font-bold text-slate-100\">\n268:                 Quick Judge Demonstration Lab (3-Minute Tour)\n269:               </h2>\n270:             </div>\n271:             <p className=\"text-xs text-slate-400 mt-1\">\n272:               Select one of the 3 pre-configured benchmark scenarios to inspect the complete explainable triage workflow.\n273:             </p>\n274:           </div>\n275:         </div>\n276: \n277:         <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n278:           {/* Case A */}\n279:           <div\n280:             onClick={() => onSelectDemoCase('case_a')}\n281:             className=\"p-4 rounded-xl bg-slate-900/90 border border-slate-700/80 hover:border-emerald-500/60 transition cursor-pointer group\"\n282:           >\n283:             <div className=\"flex items-center justify-between mb-2\">\n284:               <span className=\"text-xs font-bold font-mono text-emerald-400 uppercase tracking-wider\">\n285:                 Case A: Legitimate Unusual\n286:               </span>\n287:               <ArrowRight className=\"w-4 h-4 text-slate-400 group-hover:text-emerald-400 group-hover:translate-x-1 transition\" />\n288:             </div>\n289:             <p className=\"text-xs text-slate-300 font-medium mb-1\">\n290:               $750.00 Luxury Goods on Trusted Device\n291:             </p>\n292:             <p className=\"text-[11px] text-slate-400 leading-relaxed\">\n293:               Demonstrates why a single high amount is not automatically criminalized when contextual device integrity is verified.\n294:             </p>\n295:           </div>\n296: \n297:           {/* Case B */}\n298:           <div\n299:             onClick={() => onSelectDemoCase('case_b')}\n300:             className=\"p-4 rounded-xl bg-slate-900/90 border border-slate-700/80 hover:border-rose-500/60 transition cursor-pointer group\"\n301:           >\n302:             <div className=\"flex items-center justify-between mb-2\">\n303:               <span className=\"text-xs font-bold font-mono text-rose-400 uppercase tracking-wider\">\n304:                 Case B: Suspicious Account Takeover\n305:               </span>\n306:               <ArrowRight className=\"w-4 h-4 text-slate-400 group-hover:text-rose-400 group-hover:translate-x-1 transition\" />\n307:             </div>\n308:             <p className=\"text-xs text-slate-300 font-medium mb-1\">\n309:               $3,480.00 Anomaly from Foreign IP + 4 Failed Attempts\n310:             </p>\n311:             <p className=\"text-[11px] text-slate-400 leading-relaxed\">\n312:               High risk triage driven by multiple independent signals: novel device, foreign geo, and brute-force attempt burst.\n313:             </p>\n314:           </div>\n315: \n316:           {/* Case C */}\n317:           <div\n318:             onClick={() => onSelectDemoCase('case_c')}\n319:             className=\"p-4 rounded-xl bg-slate-900/90 border border-slate-700/80 hover:border-amber-500/60 transition cursor-pointer group\"\n320:           >\n321:             <div className=\"flex items-center justify-between mb-2\">\n322:               <span className=\"text-xs font-bold font-mono text-amber-400 uppercase tracking-wider\">\n323:                 Case C: Coordinated Syndicate\n324:               </span>\n325:               <ArrowRight className=\"w-4 h-4 text-slate-400 group-hover:text-amber-400 group-hover:translate-x-1 transition\" />\n326:             </div>\n327:             <p className=\"text-xs text-slate-300 font-medium mb-1\">\n328:               3 Distinct Accounts Sharing 1 Device & IP\n329:             </p>\n330:             <p className=\"text-[11px] text-slate-400 leading-relaxed\">\n331:               Explores NetworkX graph intelligence revealing rapid-fire multi-account money laundering ring.\n332:             </p>\n333:           </div>\n334:         </div>\n335:       </div>\n336:     </div>\n337:   );\n338: };"}
{"step_index":23,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-29T14:07:26Z","content":"Created At: 2026-10-29T19:37:26+05:30\nCompleted At: 2026-10-29T19:37:27+05:30\nShowing lines 1-63 of 63\n1: \"\"\"\n2: FraudLens AI - Backend Application Entrypoint\n3: FastAPI application with OpenAPI docs, CORS, and mounted routers.\n4: \"\"\"\n5: \n6: from pathlib import Path\n7: from fastapi import FastAPI\n8: from fastapi.middleware.cors import CORSMiddleware\n9: from fastapi.staticfiles import StaticFiles\n10: from fastapi.responses import FileResponse\n11: from app.api.endpoints import router as api_router\n12: \n13: app = FastAPI(\n14:     title=\"FraudLens AI - Explainable Financial Risk & Fraud Analytics\",\n15:     description=(\n16:         \"Production-grade financial fraud detection engine combining \"\n17:         \"three-outcome triage, transparent feature contributions, \"\n18:         \"NetworkX graph relationship analysis, and FraudLens Replay Lab.\"\n19:     ),\n20:     version=\"1.2.0\"\n21: )\n22: \n23: # CORS Middleware for modern frontend integration\n24: app.add_middleware(\n25:     CORSMiddleware,\n26:     allow_origins=[\"*\"],\n27:     allow_credentials=True,\n28:     allow_methods=[\"*\"],\n29:     allow_headers=[\"*\"],\n30: )\n31: \n32: # Include Core API Router\n33: app.include_router(api_router, prefix=\"/api\")\n34: \n35: # Serve frontend build if dist directory exists\n36: FRONTEND_DIST = Path(__file__).resolve().parents[2] / \"frontend\" / \"dist\"\n37: if FRONTEND_DIST.exists():\n38:     app.mount(\"/assets\", StaticFiles(directory=str(FRONTEND_DIST / \"assets\")), name=\"assets\")\n39: \n40:     @app.get(\"/\")\n41:     def index():\n42:         return FileResponse(str(FRONTEND_DIST / \"index.html\"))\n43: \n44:     @app.get(\"/{full_path:path}\")\n45:     def serve_frontend(full_path: str):\n46:         file_path = FRONTEND_DIST / full_path\n47:         if file_path.is_file():\n48:             return FileResponse(str(file_path))\n49:         return FileResponse(str(FRONTEND_DIST / \"index.html\"))\n50: else:\n51:     @app.get(\"/\")\n52:     def root():\n53:         return {\n54:             \"app\": \"FraudLens AI\",\n55:             \"tagline\": \"Detect smarter. Explain every alert. Reduce false alarms.\",\n56:             \"api_docs\": \"/docs\",\n57:             \"openapi_spec\": \"/openapi.json\",\n58:             \"status\": \"online\"\n59:         }\n60: \n61: if __name__ == \"__main__\":\n62:     import uvicorn\n63:     uvicorn.run(\"app.main:app\", host=\"127.0.0.1\", port=8000, reload=True)"}
